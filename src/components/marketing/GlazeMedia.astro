---
import { orderFilms, type Film } from '../../data/glazeFilms';
interface Props { films: Film[]; halloween?: boolean; }
const { films, halloween = false } = Astro.props;
const orderedFilms = orderFilms(films, halloween);
const firstFilm = orderedFilms[0];
const media = '/projects/glaze/';
---

{firstFilm && <section class="glaze-media product-section" id="films" aria-labelledby="films-heading" aria-roledescription="carousel">
  <div class="media-heading">
    <div class="product-section-heading">
      <h2 id="films-heading">Glaze in action.</h2>
    </div>
    <a class="media-jump" href="#film-choices">Explore all {orderedFilms.length} <span aria-hidden="true">↓</span></a>
  </div>

  <div class="media-stage">
    <div class="media-screen">
      <video id="glaze-film" controls playsinline preload="none" poster={`${media}${firstFilm.thumb}.webp`} width="1920" height="1080" aria-labelledby="film-title">
        <source src={`${media}${firstFilm.file}.mp4`} type="video/mp4" />
        <track kind="captions" src={`${media}${firstFilm.file}.vtt`} srclang="en" label="English" />
        <p><a href={`${media}${firstFilm.file}.mp4`}>Watch the Glaze film</a></p>
      </video>
      <button class="media-start" type="button" aria-label={`Play ${firstFilm.title}`} aria-controls="glaze-film" hidden><span aria-hidden="true">▶</span></button>
    </div>
    <div class="media-details">
      <div class="media-copy" aria-live="polite" aria-atomic="true">
        <p class="media-category" id="film-category">{firstFilm.category}</p>
        <h3 id="film-title">{firstFilm.title}</h3>
      </div>
      <div class="media-controls" hidden>
        <span id="film-count" aria-label={`Film 1 of ${orderedFilms.length}`}>01 <span aria-hidden="true">/</span> {String(orderedFilms.length).padStart(2, '0')}</span>
        <button type="button" id="film-prev" aria-label="Previous film" aria-controls="glaze-film"><span aria-hidden="true">←</span></button>
        <button type="button" id="film-next" aria-label="Next film" aria-controls="glaze-film"><span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>

  <div class="media-rail" id="film-choices" role="group" aria-label="Choose a Glaze film">
    {orderedFilms.map((film, index) => (
      <a class="media-choice" href={`${media}${film.file}.mp4`} aria-current={index === 0 ? 'true' : undefined} aria-controls="glaze-film" data-poster={`${media}${film.thumb}.webp`} data-captions={`${media}${film.file}.vtt`} data-title={film.title} data-category={film.category} data-has4k={film.has4k === false ? 'false' : undefined}>
        <div class="media-thumb">
          <img src={`${media}${film.thumb}.webp`} alt="" width="1280" height="720" loading="lazy" />
          <span class="media-play" aria-hidden="true">▶</span>
          <span class="media-duration">{film.duration}</span>
        </div>
        <span class="media-choice-category">{String(index + 1).padStart(2, '0')} <span aria-hidden="true">/</span> {film.category}</span>
        <span class="media-choice-title">{film.title}</span>
      </a>
    ))}
  </div>
</section>}

<script>
  function initFilms() {
    const player = document.querySelector<HTMLVideoElement>('#glaze-film');
    const rail = document.querySelector<HTMLElement>('#film-choices');
    const start = document.querySelector<HTMLButtonElement>('.media-start');
    if (!player || !rail || !start) return;
    const choices = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.media-choice'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    function setFilmSource() {
      const width = player.getBoundingClientRect().width * window.devicePixelRatio;
      const suffix = width <= 1280 ? '-720p.mp4' : width <= 1920 || choices[current].dataset.has4k === 'false' ? '.mp4' : '-2160p.mp4';
      const src = choices[current].href.replace(/\.mp4$/, suffix);
      const source = player.querySelector('source')!;
      if (source.src !== src) {
        source.src = src;
        player.load();
      }
    }

    function playFilm() {
      // Keep a paused film's position and quality; select resolution when a film starts.
      if (player.currentTime === 0 || player.ended) setFilmSource();
      player.controls = true;
      void player.play().catch(() => { start.hidden = !player.paused; });
    }

    player.controls = false;
    start.hidden = false;
    start.addEventListener('click', playFilm);
    player.addEventListener('play', () => { start.hidden = true; });
    player.addEventListener('pause', () => { start.hidden = !player.paused; });
    player.addEventListener('ended', () => { start.hidden = !player.paused; });

    function selectFilm(index: number, play = false) {
      const choice = choices[index];
      if (index !== current) {
        player.pause();
        player.poster = choice.dataset.poster!;
        choices[current].removeAttribute('aria-current');
        current = index;
        player.querySelector('track')!.src = choice.dataset.captions!;
        setFilmSource();
        choice.setAttribute('aria-current', 'true');
        start.hidden = false;
        start.setAttribute('aria-label', `Play ${choice.dataset.title}`);
        document.querySelector('#film-category')!.textContent = choice.dataset.category!;
        document.querySelector('#film-title')!.textContent = choice.dataset.title!;
        const count = document.querySelector('#film-count')!;
        count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(choices.length).padStart(2, '0')}`;
        count.setAttribute('aria-label', `Film ${index + 1} of ${choices.length}`);
      }
      // Scroll only the rail, so choosing a film never moves the page away from the player.
      rail.scrollTo({ left: choice.offsetLeft, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      if (play) playFilm();
    }

    choices.forEach((choice, index) => choice.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      selectFilm(index, true);
    }));
    document.querySelector<HTMLElement>('.media-controls')!.hidden = false;
    document.querySelector('#film-prev')!.addEventListener('click', () => selectFilm((current + choices.length - 1) % choices.length));
    document.querySelector('#film-next')!.addEventListener('click', () => selectFilm((current + 1) % choices.length));
    rail.addEventListener('keydown', (event) => {
      const index = choices.indexOf(event.target as HTMLAnchorElement);
      if (index < 0 || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? choices.length - 1
        : (index + (event.key === 'ArrowRight' ? 1 : choices.length - 1)) % choices.length;
      choices[next].focus({ preventScroll: true });
      selectFilm(next);
    });
  }
  initFilms();
</script>

<style>
  .glaze-media { scroll-margin-top: 2rem; }
  .media-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; }
  .media-heading .product-section-heading { margin-bottom: 0; }
  .media-heading h2 { margin-bottom: 0; }
  .media-jump { flex-shrink: 0; display: flex; gap: 1rem; align-items: center; color: var(--glaze-accent-secondary, #a5e9fa); font-size: .8rem; padding-bottom: .4rem; }
  .media-stage { border: 1px solid var(--glaze-line, #335364); border-radius: 1.25rem; overflow: hidden; background: var(--glaze-surface, #081522); box-shadow: 0 24px 80px rgb(0 0 0 / .25); }
  .media-screen { position: relative; }
  .media-start { position: absolute; inset: 0 0 3rem; display: grid; place-items: center; width: 100%; border: 0; background: transparent; color: white; cursor: pointer; }
  .media-start[hidden] { display: none; }
  video:not([controls]) + .media-start { bottom: 0; }
  .media-start span { display: grid; place-items: center; width: 4rem; height: 4rem; border: 1px solid var(--glaze-accent-secondary, rgb(185 235 255 / .65)); border-radius: 50%; background: var(--glaze-ground, rgb(3 15 25 / .8)); font-size: 1.1rem; padding-left: .15rem; }
  .media-start:focus-visible { outline: 2px solid var(--glaze-accent, #6fdcff); outline-offset: -5px; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--glaze-ground, #020910); }
  .media-details { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.6rem 2rem; background: linear-gradient(115deg, var(--glaze-soft, rgb(53 126 148 / .12)), transparent); }
  .media-category, .media-choice-category { color: var(--glaze-accent-secondary, #89c9dc); font-size: .65rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .media-copy h3 { margin: .45rem 0; font-size: clamp(1.25rem, 2.5vw, 1.7rem); letter-spacing: -.035em; font-weight: 500; color: var(--glaze-ink, #eefaff); }
  .media-controls { display: flex; align-items: center; gap: .65rem; flex-shrink: 0; }
  .media-controls[hidden] { display: none; }
  #film-count { color: var(--glaze-muted, #9bb5c7); font-size: .75rem; font-variant-numeric: tabular-nums; white-space: nowrap; margin-right: .6rem; }
  .media-controls button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--glaze-line, #395766); background: var(--glaze-surface, #122939); color: var(--glaze-ink, #d9f5ff); font: inherit; cursor: pointer; transition: border-color .2s, background .2s; }
  .media-controls button:hover { border-color: var(--glaze-accent, #6fdcff); background: var(--glaze-hover, #1c3c50); }
  .media-controls button:focus-visible, video:focus-visible { outline: 2px solid var(--glaze-accent, #6fdcff); outline-offset: -4px; }
  .media-rail { position: relative; display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: .25rem; scrollbar-color: var(--glaze-line, #395e70) transparent; scrollbar-width: thin; padding: .4rem .25rem 1.1rem; margin: 1.25rem -.25rem 0; }
  .media-choice { display: block; flex: 0 0 calc((100% - 3rem) / 4); min-width: 14rem; scroll-snap-align: start; border-radius: .75rem; }
  .media-thumb { position: relative; border: 2px solid transparent; border-radius: .75rem; overflow: hidden; transition: border-color .2s; background: var(--glaze-surface, #0c2030); }
  .media-thumb img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .media-choice[aria-current] .media-thumb { border-color: var(--glaze-accent, #6fdcff); }
  .media-choice:hover .media-thumb { border-color: var(--glaze-accent-secondary, #a4e5f5); }
  .media-play { position: absolute; left: .65rem; bottom: .65rem; display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; font-size: .6rem; color: white; background: var(--glaze-ground, rgb(3 15 25 / .85)); border: 1px solid var(--glaze-line, rgb(188 234 248 / .4)); }
  .media-duration { position: absolute; right: .65rem; bottom: .65rem; padding: .2rem .35rem; border-radius: .25rem; color: var(--glaze-ink, #e9f6ff); background: var(--glaze-ground, rgb(3 15 25 / .9)); font-size: .65rem; font-variant-numeric: tabular-nums; }
  .media-choice-category, .media-choice-title { display: block; padding-inline: .25rem; }
  .media-choice-category { margin-top: .8rem; font-size: .6rem; }
  .media-choice-title { margin-top: .4rem; color: var(--glaze-ink, #e0edf6); font-size: .9rem; line-height: 1.5; }
  @media (max-width: 700px) {
    .media-heading { align-items: start; }
    .media-jump { font-size: .7rem; gap: .5rem; margin-top: .1rem; }
    .media-details { padding: 1.25rem; flex-direction: column; align-items: start; gap: 1.25rem; }
    .media-controls { width: 100%; justify-content: end; }
    #film-count { margin-right: auto; }
    .media-choice { flex-basis: 70%; min-width: 0; }
    .media-stage { border-radius: .9rem; }
  }
  @media (prefers-reduced-motion: reduce) { .media-thumb, .media-controls button { transition: none; } }
</style>
