---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { RimewardLockup, RimewardMark } from '../lib/brand.ts';
---

<MarketingLayout title="Frostdev" description="Rimeward, Frostsim, Loothing, Crosspane, and Rimewire. Projects by Frostdev.">
  <section class="hub-hero splash-overlay">
    <h1>
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset="/projects/frostdev-wordmark-crystal.webp" />
        <img src="/projects/frostdev-wordmark-crystal-animated.webp" alt="Frostdev" width="1600" height="560" class="splash-wordmark" fetchpriority="high" />
      </picture>
    </h1>
    <p class="splash-tagline">Work · Play · Create</p>
  </section>

  <section class="project-carousel" id="projects" aria-label="Frostdev projects">
    <div class="projects" role="group" aria-label="Project carousel" tabindex="0">
      <div class="project-ring">
        <a class="project rimeward" href="/rimeward">
          <div class="project-art">
            <RimewardMark class="crystal" aria-hidden="true" />
            <RimewardLockup class="project-logo" aria-hidden="true" />
          </div>
          <div class="project-copy">
            <h2>Rimeward <span aria-hidden="true">↗</span></h2>
            <p>Your workspace, connected.</p>
            <span class="project-destination">Explore Rimeward</span>
          </div>
        </a>
        <a class="project frostsim" href="https://sim.frostdev.io">
          <div class="project-art">
            <img class="project-logo" src="/projects/frostsim.webp" width="720" height="178" alt="" />
          </div>
          <div class="project-copy">
            <h2>Frostsim <span aria-hidden="true">↗</span></h2>
            <p>World of Warcraft simulations.</p>
            <span class="project-destination">sim.frostdev.io</span>
          </div>
        </a>
        <a class="project loothing" href="https://loothing.xyz">
          <div class="project-art">
            <img class="loothing-mascot" src="/projects/loothing.webp" width="320" height="315" alt="" />
          </div>
          <div class="project-copy">
            <h2>Loothing <span aria-hidden="true">↗</span></h2>
            <p>Loot, raids, and your guild.</p>
            <span class="project-destination">loothing.xyz</span>
          </div>
        </a>
        <a class="project crosspane" href="/crosspane">
          <div class="project-art">
            <img class="project-logo" src="/projects/crosspane.webp" width="900" height="301" alt="" />
          </div>
          <div class="project-copy">
            <h2>Crosspane <span aria-hidden="true">↗</span></h2>
            <p>Your computers. One workspace.</p>
            <span class="project-destination">Explore Crosspane</span>
          </div>
        </a>
        <a class="project rimewire" href="/rimewire">
          <div class="project-art">
            <img class="project-logo" src="/projects/rimewire.webp" width="900" height="301" alt="" />
          </div>
          <div class="project-copy">
            <h2>Rimewire <span aria-hidden="true">↗</span></h2>
            <p>Your agents. One shared board.</p>
            <span class="project-destination">Explore Rimewire</span>
          </div>
        </a>
      </div>
    </div>
    <p id="carousel-help" class="carousel-hint"><span class="desktop-help">Drag to explore<span class="sr-only">. Use arrow keys to browse. Press Space to pause or resume.</span></span><span class="mobile-help">Swipe to explore<span class="sr-only">. Use Tab to reach each project.</span></span></p>
  </section>

  <section class="hub-summary" aria-labelledby="about-title">
    <h2 id="about-title">Tools you can make your own.</h2>
    <p>Frostdev builds open-source software for everyday work and play. Rimeward brings projects, notes, browsers and AI into one workspace. Crosspane connects the computers on your desk. Rimewire keeps an agent team's plans and progress in view. Frostsim and Loothing help World of Warcraft players compare their characters and organize their guilds.</p>
    <p>Explore each project for its current features, platform requirements and source. Our guides walk through real workflows, explain the choices involved, and show how to check that your setup works.</p>
    <a href="/guides">Find your first workflow <span aria-hidden="true">→</span></a>
  </section>
</MarketingLayout>

<style>
  .hub-summary { position: relative; z-index: 1; max-width: 48rem; margin: 2rem auto 0; padding: 2rem 2rem 3rem; color: #b3c8dc; font-size: 0.95rem; line-height: 1.8; }
  .hub-summary h2 { color: #e8f2fa; font-size: clamp(1.6rem, 4vw, 2rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .hub-summary p + p { margin-top: 1rem; }
  .hub-summary a { display: inline-block; color: #9be7ff; margin-top: 1.25rem; }
  .hub-summary a:focus-visible { outline: 2px solid #9be7ff; outline-offset: 5px; }
  .hub-hero {
    min-height: 0;
    padding: clamp(2rem, 5vh, 3.5rem) 1.5rem;
    gap: 1.75rem;
  }
  .hub-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at center, rgb(2 8 16 / 0.7), transparent 68%);
  }
  .hub-hero .splash-wordmark { display: block; width: min(88vw, 44rem); max-width: 100%; filter: none; }
  .splash-tagline { font-size: 0.75rem; letter-spacing: 0.3em; color: #b3c8dc; }
  .project-carousel {
    --card-width: clamp(14rem, calc((100vw - 8.5rem) / 3), 22.5rem);
    position: relative;
    z-index: 1;
    max-width: 76rem;
    margin: auto;
  }
  .projects { padding: 0 2rem 2rem; }
  .project-ring {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .is-rotating .projects {
    position: relative;
    height: 24rem;
    padding: 1rem 3rem;
    overflow: clip;
    cursor: grab;
    user-select: none;
    touch-action: pan-y pinch-zoom;
    mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
  }
  .projects:focus-visible { outline: 2px solid #9be7ff; outline-offset: -6px; border-radius: 1rem; }
  .is-rotating .project { cursor: grab; }
  .is-rotating .projects.is-dragging, .is-rotating .is-dragging .project { cursor: grabbing; }
  .is-rotating .project-ring {
    display: flex;
    width: max-content;
  }
  .project-ring .project-duplicate { display: none; }
  .is-rotating .project {
    display: flex;
    flex: 0 0 var(--card-width);
    width: var(--card-width);
    height: 22rem;
    background: #091422;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.15);
    backdrop-filter: none;
    transition: border-color 0.25s;
  }
  .carousel-hint {
    display: none;
    text-align: center;
    color: #8fa8c0;
    font-size: 0.75rem;
    padding: 0.5rem 1.25rem 1rem;
  }
  .is-rotating .carousel-hint { display: block; }
  .mobile-help { display: none; }
  .project {
    --project-color: #17c8f4;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(143 168 192 / 0.22);
    border-radius: 1rem;
    background: rgb(6 13 24 / 0.88);
    backdrop-filter: blur(12px);
    transition: border-color 0.25s, transform 0.25s;
  }
  .project:hover { border-color: var(--project-color); }
  .project-carousel:not(.is-rotating) .project:hover { transform: translateY(-4px); }
  .project:focus-visible { outline: 2px solid var(--project-color); outline-offset: 5px; }
  .project-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 12rem;
    padding: 2rem;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 90%, color-mix(in srgb, var(--project-color) 12%, transparent), transparent 75%);
  }
  .project-logo { position: relative; width: 100%; height: auto; max-width: 17rem; }
  .crystal { position: absolute; width: 14rem; height: 14rem; right: -3rem; top: -3rem; opacity: 0.1; transform: rotate(15deg); }
  .loothing { --project-color: #a78bfa; }
  .loothing-mascot { width: 8.5rem; height: auto; }
  .project-copy { padding: 1.5rem; border-top: 1px solid rgb(143 168 192 / 0.12); }
  h2 { display: flex; justify-content: space-between; align-items: center; font-size: 1.3rem; font-weight: 600; letter-spacing: -0.03em; }
  h2 span { color: #8fa8c0; font-size: 1.1rem; transition: color 0.25s; }
  .project:hover h2 span { color: var(--project-color); }
  .project-copy p { color: #b3c8dc; font-size: 0.9rem; margin-top: 0.5rem; }
  .project-destination { display: block; color: #8fa8c0; font-size: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 760px), (pointer: coarse) {
    .project-carousel { --card-width: min(82vw, 21rem); }
    .projects { overflow-x: auto; padding: 0 1.25rem 1rem; scroll-snap-type: x mandatory; scroll-padding-inline: 1.25rem; }
    .project-ring { display: flex; width: max-content; }
    .project { flex: 0 0 var(--card-width); width: var(--card-width); scroll-snap-align: start; }
    .carousel-hint, .mobile-help { display: block; }
    .desktop-help { display: none; }
    .project-carousel .project:hover { transform: none; }
    .hub-hero { padding-top: 3rem; padding-bottom: 2rem; }
    .project-art { height: 10rem; }
    .project-logo { max-width: 18rem; }
    .project-destination { margin-top: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project, h2 span { transition: none; }
    .project-carousel:not(.is-rotating) .project:hover { transform: none; }
  }
</style>

<script>
  const wordmark = document.querySelector<HTMLImageElement>('.splash-wordmark')!;
  const carousel = document.querySelector<HTMLElement>('.project-carousel')!;
  const ring = carousel.querySelector<HTMLElement>('.project-ring')!;
  const stage = carousel.querySelector<HTMLElement>('.projects')!;
  const projects = [...carousel.querySelectorAll<HTMLAnchorElement>('.project')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = matchMedia('(max-width: 760px), (pointer: coarse)');
  const duration = 80_000;
  let rotation: Animation | undefined;
  let playbackMode: 'auto' | 'paused' | 'playing' = 'auto';
  let hovering = false;
  let coastFrame = 0;
  let suppressClick = false;
  let drag: {
    id: number; start: number; cross: number; time: number; last: number;
    stamp: number; velocity: number; scale: number; moved: boolean;
  } | undefined;

  // Repeat the row for a seamless loop; keyboard and screen readers use the originals.
  projects.forEach(project => {
    const duplicate = project.cloneNode(true) as HTMLAnchorElement;
    duplicate.classList.add('project-duplicate');
    duplicate.setAttribute('aria-hidden', 'true');
    duplicate.tabIndex = -1;
    ring.append(duplicate);
  });

  function playback() {
    if (!rotation) return;
    const interacting = hovering || carousel.contains(document.activeElement);
    const paused = Boolean(drag || coastFrame || document.hidden || playbackMode === 'paused' || (playbackMode === 'auto' && interacting));
    const artwork = paused ? '/projects/frostdev-wordmark-crystal.webp' : '/projects/frostdev-wordmark-crystal-animated.webp';
    if (wordmark.getAttribute('src') !== artwork) wordmark.src = artwork;
    if (paused) rotation.pause();
    else rotation.play();
  }

  function position(time: number) {
    if (rotation) rotation.currentTime = ((time % duration) + duration) % duration;
  }

  function stopCoast() {
    cancelAnimationFrame(coastFrame);
    coastFrame = 0;
  }

  function finishDrag(event?: PointerEvent) {
    if (!drag || (event && event.pointerId !== drag.id)) return;
    const gesture = drag;
    drag = undefined;
    stage.classList.remove('is-dragging');
    suppressClick = gesture.moved;
    if (stage.hasPointerCapture(gesture.id)) stage.releasePointerCapture(gesture.id);
    let velocity = event?.type === 'pointerup' && event.timeStamp - gesture.stamp < 80 ? gesture.velocity : 0;
    if (gesture.moved && Math.abs(velocity) > 0.02) {
      let previous = performance.now();
      const coast = (now: number) => {
        const elapsed = Math.min(now - previous, 32);
        previous = now;
        position(Number(rotation?.currentTime) - velocity * elapsed * gesture.scale);
        velocity *= Math.exp(-elapsed / 200);
        if (Math.abs(velocity) > 0.02 && !document.hidden) coastFrame = requestAnimationFrame(coast);
        else { coastFrame = 0; playback(); }
      };
      coastFrame = requestAnimationFrame(coast);
    }
    playback();
  }

  function setup() {
    const elapsed = rotation?.currentTime ?? 0;
    finishDrag();
    suppressClick = false;
    stopCoast();
    rotation?.cancel();
    rotation = undefined;
    const animated = !mobile.matches && !reducedMotion.matches;
    carousel.classList.toggle('is-rotating', animated);
    stage.tabIndex = animated || mobile.matches ? 0 : -1;
    if (!animated && !mobile.matches) stage.removeAttribute('aria-describedby');
    else stage.setAttribute('aria-describedby', 'carousel-help');
    if (!animated) return;
    const frames = [
      { transform: 'translateX(0)' },
      { transform: `translateX(calc(-${projects.length} * (var(--card-width) + 1.25rem)))` },
    ];
    rotation = ring.animate(frames, { duration, iterations: Infinity });
    rotation.currentTime = elapsed;
    playback();
  }

  stage.addEventListener('pointerdown', event => {
    if (!rotation || !event.isPrimary || event.button !== 0 || drag) return;
    stopCoast();
    suppressClick = false;
    if (playbackMode === 'playing') playbackMode = 'auto';
    const coordinate = event.clientX;
    const pixels = projects[0].offsetWidth + parseFloat(getComputedStyle(ring).columnGap);
    drag = {
      id: event.pointerId, start: coordinate, cross: event.clientY,
      time: Number(rotation.currentTime), last: coordinate, stamp: event.timeStamp,
      velocity: 0, scale: duration / projects.length / pixels, moved: false,
    };
    playback();
  });
  window.addEventListener('pointermove', event => {
    if (!drag || event.pointerId !== drag.id) return;
    const coordinate = event.clientX;
    const delta = coordinate - drag.start;
    const cross = event.clientY - drag.cross;
    if (!drag.moved) {
      if (Math.abs(delta) < 8 || Math.abs(delta) < Math.abs(cross)) return;
      drag.moved = true;
      stage.classList.add('is-dragging');
      stage.setPointerCapture(event.pointerId);
      if (carousel.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
    }
    event.preventDefault();
    const speed = (coordinate - drag.last) / Math.max(1, event.timeStamp - drag.stamp);
    drag.velocity = Math.max(-2, Math.min(2, drag.velocity * 0.65 + speed * 0.35));
    drag.last = coordinate;
    drag.stamp = event.timeStamp;
    position(drag.time - delta * drag.scale);
  });
  window.addEventListener('pointerup', finishDrag);
  window.addEventListener('pointercancel', finishDrag);
  stage.addEventListener('lostpointercapture', event => {
    if (event.target === stage) finishDrag(event);
  });
  window.addEventListener('blur', () => { finishDrag(); stopCoast(); playback(); });
  stage.addEventListener('dragstart', event => { if (rotation) event.preventDefault(); });
  stage.addEventListener('click', event => {
    if (!suppressClick) return;
    event.preventDefault();
    event.stopImmediatePropagation();
    suppressClick = false;
  }, true);
  carousel.addEventListener('keydown', event => {
    suppressClick = false;
    if (!rotation) return;
    const backward = 'ArrowLeft';
    const forward = 'ArrowRight';
    if (event.key === ' ') {
      event.preventDefault();
      if (event.repeat) return;
      stopCoast();
      playbackMode = rotation.playState === 'running' ? 'paused' : 'playing';
      playback();
    } else if (event.key === backward || event.key === forward) {
      event.preventDefault();
      stopCoast();
      const index = Math.round(Number(rotation.currentTime) * projects.length / duration) + (event.key === forward ? 1 : -1);
      projects[(index % projects.length + projects.length) % projects.length].focus();
    }
  });
  stage.addEventListener('pointerenter', event => {
    hovering = event.pointerType === 'mouse';
    if (hovering && playbackMode === 'playing') playbackMode = 'auto';
    playback();
  });
  stage.addEventListener('pointerleave', () => { hovering = false; playback(); });
  carousel.addEventListener('focusin', event => {
    const index = projects.indexOf(event.target as HTMLAnchorElement);
    if (!drag && !coastFrame) {
      if (playbackMode === 'playing') playbackMode = 'auto';
      if (rotation && index >= 0) position(index * duration / projects.length);
    }
    playback();
  });
  carousel.addEventListener('focusout', () => queueMicrotask(playback));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { finishDrag(); stopCoast(); }
    playback();
  });
  reducedMotion.addEventListener('change', setup);
  mobile.addEventListener('change', setup);
  setup();
</script>
