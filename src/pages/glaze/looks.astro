---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { loadLooks, TAGS, GLAZE_VERSION } from '../../../scripts/looks.mjs';
import '../../styles/products.css';

// Every entry is checked as the page builds (scripts/looks.mjs); one bad entry stops the build.
const { looks, errors } = await loadLooks();
if (errors.length) throw new Error(`Looks gallery:\n${errors.join('\n')}`);
looks.sort((a, b) => b.created.localeCompare(a.created) || a.name.localeCompare(b.name));

const repo = 'https://github.com/frostdev-ops/frostdev.io';
const submit = `${repo}/issues/new?template=glaze-look.yml`;
const guide = `${repo}/blob/main/docs/looks-gallery.md`;
// Filters: one group each for kind and light/dark (either value matches), then each tag on its own.
const groups: [string, [string, string][]][] = [
  ['kind', [['look', 'Looks'], ['palette', 'Palettes']]],
  ['mode', [['dark', 'Dark'], ['light', 'Light']]],
  ['animated', [['animated', 'Animated']]],
  ...Object.entries(TAGS).map(([tag, label]): [string, [string, string][]] => [tag, [[tag, label]]]),
];
const used = new Set(looks.flatMap((l) => [l.kind, l.mode, ...(l.animated ? ['animated'] : []), ...l.tags]));
const filters = groups.map(([g, opts]) => [g, opts.filter(([v]) => used.has(v))] as const).filter(([, opts]) => opts.length);
const label = (tag: string) => (TAGS as Record<string, string>)[tag] || tag;
const day = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const host = (url: string) => new URL(url).hostname;
---

<MarketingLayout title="Glaze Looks — free themes for Blackboard Ultra and Canvas" description={`${looks.length} free Looks and palettes for Glaze, shared openly. Preview one, then wear it on Blackboard Ultra or Canvas. No accounts, no tracking.`} path="/glaze/looks">
  <div class="product-page looks-page">
    <section class="looks-hero" aria-labelledby="looks-title">
      <p class="product-eyebrow"><a href="/glaze">Glaze</a> · Looks gallery</p>
      <h1 class="product-title" id="looks-title">Looks, free to wear.</h1>
      <p class="product-lead">Palettes, fonts and backgrounds for Glaze, shared openly. Pick one and Glaze shows it to you first; nothing changes until you say so. No accounts, no likes, no tracking.</p>
      <div class="product-actions">
        <a class="product-button" href="#using">How to use a Look <span aria-hidden="true">↓</span></a>
        <a class="product-button secondary" href={submit}>Share your Look <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <div class="looks-tools" id="looks-tools" hidden>
      <div class="looks-search">
        <label for="looks-find" class="sr-only">Search Looks</label>
        <input type="search" id="looks-find" placeholder="Search names, people and tags" autocomplete="off" spellcheck="false" />
        <label class="looks-sort">Sort <select id="looks-sort"><option value="new">Newest</option><option value="name">Name</option></select></label>
      </div>
      <div class="looks-filters" role="group" aria-label="Filter by tag">
        {filters.flatMap(([g, opts]) => opts.map(([v, text]) => <button type="button" class="looks-chip" data-group={g} data-value={v} aria-pressed="false">{text}</button>))}
      </div>
      <p class="looks-count" id="looks-count" role="status"></p>
    </div>

    <ul class="looks-grid" id="looks-grid">
      {looks.map((l) => {
        const tags = [l.kind, l.mode, ...(l.animated ? ['animated'] : []), ...l.tags];
        const search = [l.name, l.author, l.kind, l.mode, ...tags.map(label)].join(' ').toLowerCase();
        return (
          <li class="look-card" id={l.id} data-name={l.name} data-created={l.created} data-tags={tags.join(' ')} data-search={search}>
            <figure class="look-preview">
              <a href={l.previews[0].src} aria-label={`${l.name}: full-size preview`}><img src={l.previews[0].src} width="960" height="413" loading="lazy" decoding="async" alt={`${l.name} on a Canvas dashboard`} /></a>
              {l.previews.length > 1 && (
                <figcaption class="look-modes" role="group" aria-label="Preview">
                  {l.previews.map((p, i) => <button type="button" data-src={p.src} aria-pressed={i === 0 ? 'true' : 'false'}>{p.mode === 'dark' ? 'Dark' : 'Light'}</button>)}
                </figcaption>
              )}
            </figure>
            <div class="look-body">
              <h2><a href={`#${l.id}`}>{l.name}</a></h2>
              <p class="look-meta">{l.kind === 'look' ? 'Look' : 'Palette'} by <a href={`https://github.com/${l.author}`} rel="nofollow">@{l.author}</a> · <time datetime={l.created}>{day(l.created)}</time></p>
              <span class="look-chips" role="img" aria-label={`Colors: ${l.chips.join(', ')}`}>
                {l.chips.map((c) => <i style={`background:${c}`}></i>)}
              </span>
              <ul class="look-tags" aria-label="Tags">
                {tags.filter((t) => t !== l.kind).map((t) => <li>{t === 'dark' ? 'Dark' : t === 'light' ? 'Light' : t === 'animated' ? 'Animated' : label(t)}</li>)}
              </ul>
              {l.image && (
                <p class="look-image">Its background image is on <strong>{host(l.image)}</strong>, which gets your visit when you see it.
                  <button type="button" data-image={l.image}>Show the image</button></p>
              )}
              <div class="look-actions">
                <a class="product-button" href="#using" data-glaze-use data-code={l.code} data-name={l.name} data-author={l.author}>Use this Look in Glaze</a>
                <button type="button" class="product-button secondary" data-copy={l.code}>Copy code</button>
              </div>
              <details class="look-code"><summary>Theme code</summary><code>{l.code}</code></details>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="looks-none" id="looks-none" hidden>No Looks match. Try fewer filters.</p>

    <section class="product-section product-split" id="using" aria-labelledby="using-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Using a Look</p>
        <h2 id="using-heading">Preview first. Then wear it.</h2>
        <p>Don't have Glaze yet? <a class="product-text-link" href="/glaze">Get Glaze for Chrome or Safari →</a></p>
      </div>
      <div class="product-panel">
        <h3>In one click</h3>
        <p>With the newest Glaze, <strong>Use this Look in Glaze</strong> opens Glaze's editor with the Look in its preview. Choose <strong>Use this theme</strong> to wear it, <strong>Save to favorites</strong> to keep it for later, or Cancel. Glaze keeps your favorites and a history of the themes you wore on your computer, with a Previous Look button.</p>
        <h3>By hand</h3>
        <p>Choose <strong>Copy code</strong>, open Glaze's editor, go to <strong>Share</strong> and paste the code. This works in every Glaze since 2.1.</p>
        <p>A palette changes only your colors. A Look also sets fonts, shape and background.</p>
      </div>
    </section>

    <section class="product-section product-split" id="share" aria-labelledby="share-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Open to everyone</p>
        <h2 id="share-heading">Share your Look.</h2>
        <p>Copy your theme code in Glaze, take a screenshot of it on your Blackboard or Canvas, and send both through a GitHub issue or pull request. Every code is checked by Glaze {GLAZE_VERSION}'s own code before it's published here.</p>
        <div class="product-actions"><a class="product-button" href={submit}>Share a Look <span aria-hidden="true">↗</span></a><a class="product-button secondary" href={guide}>How it works <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="product-panel">
        <h3>License</h3>
        <p>Submitted Looks and their screenshots are shared under <a class="looks-link" href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>. When sharing or adapting one, credit its author, link to the license and say what you changed. Glaze’s built-in Looks and palettes keep their existing license.</p>
        <h3>Privacy</h3>
        <p>This page is static. It has no accounts, likes, comments or analytics, and it loads nothing from other sites: a Look's own background image loads only when you choose to see it. Glaze sends nothing when you visit.</p>
        <h3>Report a Look</h3>
        <p>Something here that shouldn't be? Email <a class="looks-link" href="mailto:admin@frostdev.io?subject=Glaze%20Looks%20gallery%20report">admin@frostdev.io</a> or <a class="looks-link" href={`${repo}/issues/new?title=Report%3A%20`}>open an issue</a> with the Look's name. We take it down first and look into it after.</p>
      </div>
    </section>
  </div>
</MarketingLayout>

<script>
  const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const grid = $<HTMLUListElement>('#looks-grid');
  const cards = [...grid.children] as HTMLElement[];
  const find = $<HTMLInputElement>('#looks-find');
  const sort = $<HTMLSelectElement>('#looks-sort');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.looks-chip')];
  $<HTMLElement>('#looks-tools').hidden = false;

  const update = () => {
    const words = find.value.toLowerCase().split(/\s+/).filter(Boolean);
    // Within a group any picked value matches; across groups all must.
    const picked = new Map<string, string[]>();
    for (const c of chips) if (c.getAttribute('aria-pressed') === 'true') picked.set(c.dataset.group!, [...(picked.get(c.dataset.group!) || []), c.dataset.value!]);
    let shown = 0;
    for (const card of cards) {
      const tags = card.dataset.tags!.split(' ');
      card.hidden = !(words.every((w) => card.dataset.search!.includes(w)) && [...picked.values()].every((vs) => vs.some((v) => tags.includes(v))));
      if (!card.hidden) shown++;
    }
    const byName = (a: HTMLElement, b: HTMLElement) => a.dataset.name!.localeCompare(b.dataset.name!);
    cards.sort(sort.value === 'name' ? byName : (a, b) => b.dataset.created!.localeCompare(a.dataset.created!) || byName(a, b));
    grid.append(...cards);
    $<HTMLElement>('#looks-count').textContent = shown === cards.length ? `${cards.length} Looks` : `${shown} of ${cards.length} Looks`;
    $<HTMLElement>('#looks-none').hidden = shown > 0;
  };
  find.addEventListener('input', update);
  sort.addEventListener('change', update);
  for (const c of chips) c.addEventListener('click', () => { c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')); update(); });
  update();

  grid.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    const card = b.closest<HTMLElement>('.look-card')!;
    if (b.dataset.copy) {
      try {
        await navigator.clipboard.writeText(b.dataset.copy);
        b.textContent = 'Copied';
        setTimeout(() => { b.textContent = 'Copy code'; }, 2000);
      } catch {
        // No clipboard here: show the code, selected, for the student to copy.
        const details = $<HTMLDetailsElement>('.look-code', card);
        details.open = true;
        getSelection()?.selectAllChildren($('code', details));
      }
    } else if (b.dataset.src) {
      $<HTMLImageElement>('.look-preview img', card).src = b.dataset.src;
      $<HTMLAnchorElement>('.look-preview a', card).href = b.dataset.src;
      for (const x of b.parentElement!.children) x.setAttribute('aria-pressed', String(x === b));
    } else if (b.dataset.image) {
      // Another site's image: fetched only now, on the student's click, without a referrer.
      const img = Object.assign(document.createElement('img'), { src: b.dataset.image, alt: `Background image of ${card.dataset.name}`, referrerPolicy: 'no-referrer', loading: 'lazy' });
      img.className = 'look-bg';
      b.replaceWith(img);
    }
  });
</script>

<style>
  .looks-page { --product-accent: #6fdcff; }
  .looks-hero { padding: 4rem 0 2.5rem; max-width: 46rem; }
  .looks-hero .product-eyebrow a:hover { color: #e2f8ff; }
  .looks-tools { position: sticky; top: .5rem; z-index: 3; display: grid; gap: .85rem; padding: 1rem; margin-bottom: 1.5rem; border: 1px solid #23394e; border-radius: .75rem; background: rgb(6 13 24 / .88); backdrop-filter: blur(10px); }
  .looks-search { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .looks-search input { flex: 1 1 16rem; min-width: 0; padding: .7rem 1rem; border: 1px solid #35506a; border-radius: .5rem; background: rgb(12 27 44 / .8); color: #e8f2fa; }
  .looks-search input::placeholder { color: #8fa8c0; }
  .looks-sort { display: flex; align-items: center; gap: .5rem; color: #b3c8dc; font-size: .85rem; }
  .looks-sort select { padding: .6rem .75rem; border: 1px solid #35506a; border-radius: .5rem; background: #0a1725; color: #e8f2fa; }
  .looks-filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .looks-chip { padding: .35rem .8rem; border: 1px solid #35506a; border-radius: 999px; color: #b3c8dc; font-size: .8rem; background: rgb(12 27 44 / .6); }
  .looks-chip:hover { border-color: var(--product-accent); color: #e8f2fa; }
  .looks-chip[aria-pressed='true'] { background: var(--product-accent); border-color: var(--product-accent); color: #06121c; font-weight: 600; }
  .looks-count { color: #8fa8c0; font-size: .8rem; }
  :is(.looks-search input, .looks-sort select, .looks-chip, .look-card button, .look-code summary):focus-visible { outline: 2px solid var(--product-accent); outline-offset: 2px; }
  .looks-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); gap: 1.25rem; }
  .look-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid #23394e; border-radius: .75rem; background: rgb(10 23 37 / .85); overflow: hidden; scroll-margin-top: 9rem; }
  .look-card:target { border-color: var(--product-accent); }
  .look-preview { position: relative; background: #02060d; }
  .look-preview img { width: 100%; aspect-ratio: 960 / 413; object-fit: cover; }
  .look-modes { position: absolute; right: .5rem; bottom: .5rem; display: flex; gap: .25rem; }
  .look-modes button { padding: .2rem .6rem; border-radius: 999px; font-size: .7rem; color: #e8f2fa; background: rgb(6 13 24 / .8); }
  .look-modes button[aria-pressed='true'] { color: #06121c; background: var(--product-accent); }
  .look-body { display: grid; gap: .75rem; padding: 1.1rem 1.25rem 1.25rem; flex: 1; align-content: start; }
  .look-body h2 { color: #e8f2fa; font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .look-meta { color: #8fa8c0; font-size: .8rem; }
  .look-meta a, .looks-link { color: #9be7ff; }
  .look-meta a:hover, .looks-link:hover { text-decoration: underline; }
  .look-chips { display: flex; width: max-content; border: 1px solid #35506a; border-radius: 999px; overflow: hidden; }
  .look-chips i { width: 1.6rem; height: 1.1rem; }
  .look-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .look-tags li { padding: .1rem .55rem; border: 1px solid #23394e; border-radius: 999px; color: #b3c8dc; font-size: .7rem; }
  .look-image { color: #b3c8dc; font-size: .8rem; line-height: 1.6; }
  .look-image button { display: block; margin-top: .35rem; color: #9be7ff; text-decoration: underline; }
  .look-bg { margin-top: .5rem; border-radius: .5rem; max-height: 12rem; object-fit: cover; }
  .look-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .25rem; }
  .look-actions .product-button { padding: .65rem 1rem; font-size: .8rem; }
  .look-code summary { cursor: pointer; color: #8fa8c0; font-size: .75rem; width: max-content; }
  .look-code code { display: block; margin-top: .5rem; padding: .75rem; border: 1px solid #23394e; border-radius: .5rem; background: #060d18; color: #c0e6ec; font-size: .7rem; line-height: 1.5; overflow-wrap: anywhere; user-select: all; }
  .looks-none { padding: 3rem 0; color: #b3c8dc; text-align: center; }
  #using, #share { margin-top: 4rem; }
  .product-panel h3 + p { margin-bottom: 1.25rem; }
  @media (max-width: 700px) {
    .looks-hero { padding-top: 2.5rem; }
    .looks-tools { position: static; }
  }
</style>
