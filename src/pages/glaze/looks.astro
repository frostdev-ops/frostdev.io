---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import LookCard from '../../components/LookCard.astro';
import { loadLooks, TAGS, GLAZE_VERSION } from '../../../scripts/looks.mjs';
import '../../styles/products.css';
import '../../styles/looks.css';

// Every entry is checked as the page builds (scripts/looks.mjs); one bad entry stops the build.
const { looks, errors } = await loadLooks();
if (errors.length) throw new Error(`Looks gallery:\n${errors.join('\n')}`);
looks.sort((a, b) => b.created.localeCompare(a.created) || a.name.localeCompare(b.name));

const repo = 'https://github.com/frostdev-ops/frostdev.io';
const guide = `${repo}/blob/main/docs/looks-gallery.md`;
// Filters: one group each for source, kind and light/dark (either value matches), then each tag on its own. Every
// chip is built; the script shows those that some card (curated or community) has.
const groups: [string, [string, string][]][] = [
  ['source', [['curated', 'Curated'], ['community', 'Community']]],
  ['kind', [['look', 'Looks'], ['palette', 'Palettes']]],
  ['mode', [['dark', 'Dark'], ['light', 'Light']]],
  ['animated', [['animated', 'Animated']]],
  ...Object.entries(TAGS).map(([tag, label]): [string, [string, string][]] => [tag, [[tag, label]]]),
];
const used = new Set(looks.flatMap((l) => ['curated', l.kind, l.mode, ...(l.animated ? ['animated'] : []), ...l.tags]));
---

<MarketingLayout title="Glaze Looks — free themes for Blackboard Ultra and Canvas" description={`${looks.length} free Looks and palettes for Glaze, shared openly. Preview one, then wear it on Blackboard Ultra or Canvas. No accounts, no tracking.`} path="/glaze/looks">
  <div class="product-page looks-page">
    <section class="looks-hero" aria-labelledby="looks-title">
      <p class="product-eyebrow"><a href="/glaze">Glaze</a> · Looks gallery</p>
      <h1 class="product-title" id="looks-title">Looks, free to wear.</h1>
      <p class="product-lead">Palettes, fonts and backgrounds for Glaze, shared openly. Pick one and Glaze shows it to you first; nothing changes until you say so. No accounts, no likes, no tracking.</p>
      <div class="product-actions">
        <a class="product-button" href="#using">How to use a Look <span aria-hidden="true">↓</span></a>
        <a class="product-button secondary" href="/glaze/looks/submit">Share your Look <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <div class="looks-tools" id="looks-tools" hidden>
      <div class="looks-search">
        <label for="looks-find" class="sr-only">Search Looks</label>
        <input type="search" id="looks-find" placeholder="Search names, people and tags" autocomplete="off" spellcheck="false" />
        <label class="looks-sort">Sort <select id="looks-sort"><option value="new">Newest</option><option value="name">Name</option></select></label>
      </div>
      <div class="looks-filters" role="group" aria-label="Filter by tag">
        {groups.flatMap(([g, opts]) => opts.map(([v, text]) => <button type="button" class="looks-chip" data-group={g} data-value={v} aria-pressed="false" hidden={!used.has(v)}>{text}</button>))}
      </div>
      <p class="looks-count" id="looks-count" role="status"></p>
    </div>

    <ul class="looks-grid" id="looks-grid">
      {looks.map((l) => <LookCard look={l} />)}
    </ul>
    <template id="look-template"><LookCard /></template>
    <dialog id="look-dialog" class="look-dialog" aria-labelledby="look-dialog-title">
      <div class="look-dialog-head">
        <h2 class="look-dialog-title" id="look-dialog-title">Preview</h2>
        <form method="dialog"><button class="product-button secondary">Close</button></form>
      </div>
      <div class="look-dialog-stage"></div>
      <p class="look-dialog-note">A stand-in course page painted with the Look's colors, text size, shape and background. Glaze paints your real Blackboard, Canvas or Moodle pages the same way.</p>
    </dialog>
    <p class="looks-none" id="looks-none" hidden>No Looks match. Try fewer filters.</p>

    <section class="product-section product-split" id="using" aria-labelledby="using-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Using a Look</p>
        <h2 id="using-heading">Preview first. Then wear it.</h2>
        <p>Don't have Glaze yet? <a class="product-text-link" href="/glaze">Get Glaze for Chrome or Safari →</a></p>
      </div>
      <div class="product-panel">
        <h3>In one click</h3>
        <p>With the newest Glaze, <strong>Use this Look in Glaze</strong> opens Glaze's editor with the Look in its preview. Choose <strong>Use this theme</strong> to wear it, <strong>Save to favorites</strong> to keep it for later, or Cancel. Glaze keeps your favorites and a history of the themes you wore on your computer, with a Previous Look button.</p>
        <h3>By hand</h3>
        <p>Choose <strong>Copy code</strong>, open Glaze's editor, go to <strong>Share</strong> and paste the code. This works in every Glaze since 2.1.</p>
        <p>A palette changes only your colors. A Look also sets fonts, shape and background.</p>
      </div>
    </section>

    <section class="product-section product-split" id="share" aria-labelledby="share-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Open to everyone</p>
        <h2 id="share-heading">Share your Look.</h2>
        <p>Copy your theme code in Glaze and paste it into the submit page: it shows your Look live and checks it with Glaze {GLAZE_VERSION}'s own code as you type. When you submit, an automated review decides whether it's safe for a school audience, polished and different enough from the Looks already here, and tells you why if not. No account, no screenshot needed.</p>
        <div class="product-actions"><a class="product-button" href="/glaze/looks/submit">Share a Look <span aria-hidden="true">→</span></a><a class="product-button secondary" href={guide}>How it works <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="product-panel">
        <h3>License</h3>
        <p>Submitted Looks and their screenshots are shared under <a class="looks-link" href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>. When sharing or adapting one, credit its author, link to the license and say what you changed. Glaze’s built-in Looks and palettes keep their existing license.</p>
        <h3>Privacy</h3>
        <p>No accounts, likes, comments or analytics, and nothing loads from other sites: a Look's own background image loads only when you choose to see it. The curated Looks are part of this page. To add the community's Looks, the page asks frostdev.io itself for their list, without cookies; that request records nothing about you. Glaze sends nothing when you visit.</p>
        <p>The submit page uses a one-day cookie and daily network hashes for limits; submissions have longer retention. See <a class="looks-link" href="/glaze/looks/submit#privacy">what the submit page keeps</a>.</p>
        <h3>Report a Look</h3>
        <p>Something here that shouldn't be? Email <a class="looks-link" href="mailto:admin@frostdev.io?subject=Glaze%20Looks%20gallery%20report">admin@frostdev.io</a> or <a class="looks-link" href={`${repo}/issues/new?title=Report%3A%20`}>open an issue</a> with the Look's name. We take it down first and look into it after.</p>
      </div>
    </section>
  </div>
</MarketingLayout>

<script>
  import { fillCard, showImage, wireDialog, type Look } from '../../components/looks';

  const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const grid = $<HTMLUListElement>('#looks-grid');
  let cards = [...grid.children] as HTMLElement[];
  const find = $<HTMLInputElement>('#looks-find');
  const sort = $<HTMLSelectElement>('#looks-sort');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.looks-chip')];
  $<HTMLElement>('#looks-tools').hidden = false;
  for (const f of document.querySelectorAll<HTMLElement>('.look-modes')) f.hidden = false;

  const update = () => {
    const words = find.value.toLowerCase().split(/\s+/).filter(Boolean);
    // Within a group any picked value matches; across groups all must.
    const picked = new Map<string, string[]>();
    for (const c of chips) if (c.getAttribute('aria-pressed') === 'true') picked.set(c.dataset.group!, [...(picked.get(c.dataset.group!) || []), c.dataset.value!]);
    let shown = 0;
    for (const card of cards) {
      const tags = card.dataset.tags!.split(' ');
      card.hidden = !(words.every((w) => card.dataset.search!.includes(w)) && [...picked.values()].every((vs) => vs.some((v) => tags.includes(v))));
      if (!card.hidden) shown++;
    }
    const byName = (a: HTMLElement, b: HTMLElement) => a.dataset.name!.localeCompare(b.dataset.name!);
    cards.sort(sort.value === 'name' ? byName : (a, b) => b.dataset.created!.localeCompare(a.dataset.created!) || byName(a, b));
    grid.append(...cards);
    $<HTMLElement>('#looks-count').textContent = shown === cards.length ? `${cards.length} Looks` : `${shown} of ${cards.length} Looks`;
    $<HTMLElement>('#looks-none').hidden = shown > 0;
  };
  find.addEventListener('input', update);
  sort.addEventListener('change', update);
  for (const c of chips) c.addEventListener('click', () => { c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')); update(); });
  update();
  wireDialog(grid);

  // The community's Looks, from frostdev.io's gallery server, without cookies. If it doesn't answer, the curated
  // gallery above is the whole gallery.
  const tpl = $<HTMLTemplateElement>('#look-template');
  fetch('/glaze/looks/api/looks', { credentials: 'omit', headers: { accept: 'application/json' } })
    .then((r) => (r.ok ? r.json() : null))
    .then((body: { looks?: Look[] } | null) => {
      const added = (Array.isArray(body?.looks) ? body.looks : []).map((l) => fillCard(tpl, l)).filter((c): c is HTMLElement => !!c && !document.getElementById(c.id));
      if (!added.length) return;
      cards = [...cards, ...added];
      const tags = new Set(cards.flatMap((c) => c.dataset.tags!.split(' ')));
      for (const c of chips) c.hidden = !tags.has(c.dataset.value!);
      update();
      // A link to a community card (#id) works once it's there.
      if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
    })
    .catch(() => {});

  grid.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b || b.classList.contains('lp')) return;
    const card = b.closest<HTMLElement>('.look-card')!;
    const preview = $<HTMLElement>('.lp', card);
    if (b.dataset.copy) {
      try {
        await navigator.clipboard.writeText(b.dataset.copy);
        b.textContent = 'Copied';
        setTimeout(() => { b.textContent = 'Copy code'; }, 2000);
      } catch {
        // No clipboard here: show the code, selected, for the student to copy.
        const details = $<HTMLDetailsElement>('.look-code', card);
        details.open = true;
        getSelection()?.selectAllChildren($('code', details));
      }
    } else if (b.parentElement?.classList.contains('look-modes')) {
      // Live preview, or one of a curated Look's screenshots.
      const shot = $<HTMLImageElement>('.look-shot', card);
      if (b.dataset.src) shot.src = b.dataset.src;
      shot.hidden = !b.dataset.src;
      preview.hidden = !!b.dataset.src;
      for (const x of b.parentElement.children) x.setAttribute('aria-pressed', String(x === b));
    } else if (b.dataset.image) {
      // Another site's image: fetched only now, on the student's click, without a referrer.
      showImage(preview, b.dataset.image, card.dataset.name || '');
      b.replaceWith(Object.assign(document.createElement('span'), { textContent: 'Shown in the preview above.' }));
    }
  });
</script>
