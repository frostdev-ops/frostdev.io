---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import LookPreview from '../../../components/LookPreview.astro';
import { GLAZE_VERSION } from '../../../../scripts/looks.mjs';
import '../../../styles/products.css';
import '../../../styles/looks.css';

const guide = 'https://github.com/frostdev-ops/frostdev.io/blob/main/docs/looks-gallery.md';
const style: [string, string, string][] = [
  ['minimal', 'Minimal', 'judged by the review'], ['colorful', 'Colorful', 'judged by the review'], ['seasonal', 'Seasonal', 'judged by the review'],
  ['gradient', 'Gradient', 'a gradient background'], ['serif', 'Serif', 'a serif text font'], ['monospace', 'Monospace', 'a monospace text font'],
];
const access: [string, string, string][] = [
  ['high-contrast', 'High contrast', 'text 7:1 on the surface, muted text and text on the accent 4.5:1'],
  ['low-vision', 'Low vision', 'text size 110% or more'],
  ['dyslexia-friendly', 'Dyslexia-friendly', "one of Glaze's Readable fonts or Atkinson Hyperlegible"],
];
---

<MarketingLayout title="Share a Glaze Look" description="Submit your Glaze theme to the free Looks gallery. See it live as you paste it; an automated review decides in seconds." path="/glaze/looks/submit">
  <div class="product-page looks-page submit-page">
    <section class="looks-hero" aria-labelledby="submit-title">
      <p class="product-eyebrow"><a href="/glaze">Glaze</a> · <a href="/glaze/looks">Looks gallery</a> · Share</p>
      <h1 class="product-title" id="submit-title">Share your Look.</h1>
      <p class="product-lead">In Glaze, open the editor, go to <strong>Share</strong> and choose <strong>Copy theme code</strong>. Paste it here to see it live. When you submit, an automated review checks it's right for students, polished and its own, and publishes it in seconds. One a day.</p>
    </section>

    <div class="submit-grid">
      <form class="submit-form product-panel" id="submit-form" method="post" novalidate>
        <div class="field">
          <label for="f-code">Theme code</label>
          <textarea id="f-code" name="code" rows="4" required spellcheck="false" autocomplete="off" placeholder="glaze1:… or glaze2:…" aria-describedby="f-code-help f-code-error"></textarea>
          <p class="help" id="f-code-help">Starts with <code>glaze1:</code>, or <code>glaze2:</code> for a Look with extras (a shader or layered background, animations, effects, a cursor effect, a navigation layout, page tweaks). Checked by Glaze {GLAZE_VERSION}'s own code as you type.</p>
          <p class="help" id="f-code-prefilled" hidden>This code came with the link you opened. Nothing has been sent yet. <button type="button" class="looks-link" id="f-code-check">Preview it</button></p>
          <ul class="error" id="f-code-error"></ul>
        </div>
        <div class="field" id="f-media-field" hidden>
          <label for="f-media">Background file</label>
          <input id="f-media" name="media" type="file" accept="video/webm,video/mp4,image/webp,image/avif,application/json,.json" aria-describedby="f-media-help f-media-error" />
          <p class="help" id="f-media-help">This Look's background is a video or animation file, which its code only names. Add the same file you chose in Glaze's editor (Background, a file from this computer). The gallery checks it is exactly that file, keeps it with your Look and serves it to students who use it. A person always looks at a Look with a file before it is published.</p>
          <ul class="error" id="f-media-error"></ul>
        </div>
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" required maxlength="40" autocomplete="off" aria-describedby="f-name-help f-name-error" />
          <p class="help" id="f-name-help">Up to 40 characters, shown as the Look's title. It has to fit a school audience.</p>
          <ul class="error" id="f-name-error"></ul>
        </div>
        <div class="field">
          <label for="f-credit">Credit</label>
          <input id="f-credit" name="credit" required maxlength="32" autocomplete="nickname" aria-describedby="f-credit-help f-credit-error" />
          <p class="help" id="f-credit-help">The name shown as "by …". Up to 32 letters, digits, spaces, dots, dashes or underscores; not a link or an @handle. It's public, so a nickname is fine.</p>
          <ul class="error" id="f-credit-error"></ul>
        </div>
        <fieldset class="field" aria-describedby="f-tags-help f-tags-error">
          <legend>Style</legend>
          <div class="tag-grid">
            {style.map(([v, label, note]) => <label class="tag"><input type="checkbox" name="tags" value={v} /> {label} <small>{note}</small></label>)}
          </div>
          <p class="help" id="f-tags-help">Up to 6 tags in all. Minimal, colorful and seasonal are the review's call: one it doesn't agree with is left off, not held against you.</p>
        </fieldset>
        <fieldset class="field" aria-describedby="f-access-help f-tags-error">
          <legend>Accessibility</legend>
          <div class="tag-grid">
            {access.map(([v, label, note]) => <label class="tag"><input type="checkbox" name="tags" value={v} /> {label} <small>{note}</small></label>)}
          </div>
          <p class="help" id="f-access-help">These are checked against your code, so a student who filters by them can rely on them.</p>
          <ul class="error" id="f-tags-error"></ul>
        </fieldset>
        <div class="field">
          <label class="tag license"><input type="checkbox" id="f-license" name="license" required aria-describedby="f-license-error" /> I made this theme or have the right to share it, and I license it under <a class="looks-link" href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>: anyone may wear, share and adapt it, crediting me.</label>
          <ul class="error" id="f-license-error"></ul>
        </div>
        <div class="product-actions submit-actions">
          <button type="submit" class="product-button" id="f-submit" disabled>Submit for review</button>
          <a class="product-button secondary" href="/glaze/looks">Back to the gallery</a>
        </div>
        <p class="help" id="check-status" role="status" aria-live="polite"></p>
        <div role="status" aria-live="polite"><div class="submit-status" id="submit-status" hidden></div></div>
        <noscript><p class="help">Submitting needs JavaScript. You can also share your Look through <a class="looks-link" href="https://github.com/frostdev-ops/frostdev.io/issues/new?template=glaze-look.yml">a GitHub issue</a>.</p></noscript>
      </form>

      <aside class="submit-side" aria-labelledby="live-title">
        <h2 class="submit-h2" id="live-title">Live preview</h2>
        <div class="submit-preview">
          <LookPreview name="Your Look" />
          <p class="submit-empty" id="live-empty">Paste a theme code to see it here.</p>
        </div>
        <p class="look-font" id="live-font"></p>
        <ul class="submit-contrast" id="live-contrast" aria-label="Contrast"></ul>
        <h2 class="submit-h2">Nearest Looks in the gallery</h2>
        <p class="help">The review compares yours with these. 0 is identical; Glaze's Frost and Midnight palettes are 4.6 apart.</p>
        <ol class="submit-near" id="live-near"><li class="help">None yet.</li></ol>
      </aside>
    </div>
    <dialog id="look-dialog" class="look-dialog" aria-labelledby="look-dialog-title">
      <div class="look-dialog-head">
        <h2 class="look-dialog-title" id="look-dialog-title">Preview</h2>
        <form method="dialog"><button class="product-button secondary">Close</button></form>
      </div>
      <div class="look-dialog-stage"></div>
      <p class="look-dialog-note">A stand-in course page painted with the Look's colors, text size, shape and background.</p>
    </dialog>

    <section class="product-section product-split" id="privacy" aria-labelledby="privacy-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">What happens to it</p>
        <h2 id="privacy-heading">What the review sees and keeps.</h2>
        <p>Your Look is checked by Glaze's own code, then reviewed by a decision model (<code>liquid/d1-ultra</code>) through OpenRouter: is the name and credit right for students, is it polished, is it its own Look. If it's unsure, a larger model (<code>openai/gpt-6-luna-pro</code>, which must explain every decision) decides, or asks a person, who gets an email. <a class="looks-link" href={guide}>How the review works</a></p>
      </div>
      <div class="product-panel">
        <h3>What's kept</h3>
        <p>Previewing sends your code and fields to frostdev.io to check them; those fields are not saved. Previewing or submitting sets a one-day cookie scoped to the gallery API. The preview rate limit keeps a short-lived keyed network hash in memory; submissions keep cookie and network hashes for the daily limit, with quota rows removed at the two-day cutoff. The network key is replaced daily. These identifiers are not included in review requests or notification emails: OpenRouter sees the Look, its name, credit and tags, and the nearest Looks. For a Look with extras that includes a description of them, never a shader's source; the text they carry (navigation labels, link names and addresses, rule labels) goes to the first reviewer's safety check with the name and credit. A background file is sent only when you submit, and never to OpenRouter: the reviewers are told only that there is one, and the maintainer looks at it.</p>
        <p>Published and pending Looks retain their submitted fields, review and hashed status token until acted on; published fields are public. Removed records are retained to block resubmission. A background file is kept while any published or pending Look uses it, and deleted after the last such Look is declined or taken down. Automated declines keep the submitted name, code and review for 30 days; human declines also retain the credit and status record for 30 days after the decision. Cookie and network hashes are not attached to these records. Backups and notification emails have separate retention; the gallery does not delete email copies.</p>
        <h3>Changed your mind?</h3>
        <p>Email <a class="looks-link" href="mailto:admin@frostdev.io?subject=Glaze%20Looks%20gallery">admin@frostdev.io</a> with the Look's name to have it taken down.</p>
      </div>
    </section>
  </div>
</MarketingLayout>

<script>
  import { paintPreview, wireDialog, fontLine, type Described } from '../../../components/looks';

  const API = '/glaze/looks/api';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('submit-form');
  const code = $<HTMLTextAreaElement>('f-code');
  const name = $<HTMLInputElement>('f-name');
  const credit = $<HTMLInputElement>('f-credit');
  const license = $<HTMLInputElement>('f-license');
  const mediaInput = $<HTMLInputElement>('f-media');
  const statusBox = $<HTMLElement>('submit-status');
  const preview = document.querySelector<HTMLElement>('.submit-preview .lp')!;
  // While the gallery server is down, the GitHub issue form is the way in: a maintainer adds the Look by hand.
  const issue = 'https://github.com/frostdev-ops/frostdev.io/issues/new?template=glaze-look.yml';
  wireDialog(document);

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text = '', cls = '') => { const e = document.createElement(tag); if (text) e.textContent = text; if (cls) e.className = cls; return e; };
  const link = (href: string, text: string) => Object.assign(el('a', text, 'looks-link'), { href });
  const pct = (v: number) => `${Math.round(v * 100)}%`;
  const tags = () => [...form.querySelectorAll<HTMLInputElement>('input[name="tags"]:checked')].map((i) => i.value);

  // Problems from the server, each under the field it's about.
  const fields: [RegExp, string, HTMLElement | null][] = [
    [/\bname\b/, 'f-name-error', name], [/credit/, 'f-credit-error', credit], [/tag/, 'f-tags-error', null], [/agree|license/, 'f-license-error', license], [/background file/, 'f-media-error', mediaInput], [/./, 'f-code-error', code],
  ];
  const showProblems = (problems: string[]) => {
    for (const [, id, input] of fields) { $(id).replaceChildren(); input?.removeAttribute('aria-invalid'); }
    for (const p of problems) {
      const [, id, input] = fields.find(([re]) => re.test(p))!;
      $(id).append(el('li', p.charAt(0).toUpperCase() + p.slice(1) + '.'));
      input?.setAttribute('aria-invalid', 'true');
    }
  };
  const say = (...nodes: (Node | string)[]) => { statusBox.replaceChildren(...nodes); statusBox.hidden = false; statusBox.scrollIntoView({ block: 'nearest' }); };
  const closed = () => {
    const p = el('p', 'You can still share it through ');
    p.append(link(issue, 'a GitHub issue'), '; a maintainer adds it by hand.');
    say(el('p', "Submissions are closed for now: the gallery server isn't answering."), p);
  };

  // ---- the live check: debounced, never stored, never uses the day's submission ------------------------------------
  let timer = 0;
  let seq = 0;
  let reviewing = false;
  const check = async () => {
    if (reviewing) return;
    const mine = ++seq;
    const value = code.value.trim();
    if (!value) { showProblems([]); paint(null); return; }
    let r: Response;
    try {
      r = await fetch(`${API}/check`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code: value, ...(name.value && { name: name.value }), ...(credit.value && { credit: credit.value }), tags: tags() }) });
    } catch { if (mine === seq) closed(); return; }
    if (mine !== seq) return;
    if (r.status === 429) return;
    if (!r.ok) { closed(); return; }
    const body = await r.json().catch(() => null);
    if (mine !== seq || reviewing) return;
    if (!body) { closed(); return; }
    const count = Array.isArray(body.problems) ? body.problems.length : 0;
    $('check-status').textContent = count ? `${count} problem${count === 1 ? '' : 's'} found. Check the marked fields.` : 'Preview checked. No problems found.';
    showProblems(Array.isArray(body.problems) ? body.problems.map(String) : []);
    paint(body.look || null, Array.isArray(body.nearest) ? body.nearest : []);
  };
  const later = () => { if (reviewing) return; ++seq; clearTimeout(timer); timer = window.setTimeout(check, 400); };
  for (const input of [code, name, credit]) input.addEventListener('input', later);
  form.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).name === 'tags' && code.value.trim()) later(); });

  // The background file the student chose: shown in the live preview from this computer, sent only with the submission.
  let lastLook: Described | null = null;
  let mediaUrl = '';
  const needsFile = () => !!lastLook?.media;
  mediaInput.addEventListener('change', () => {
    if (mediaUrl) URL.revokeObjectURL(mediaUrl);
    const f = mediaInput.files?.[0];
    mediaUrl = f ? URL.createObjectURL(f) : '';
    $('f-media-error').replaceChildren();
    mediaInput.removeAttribute('aria-invalid');
    if (lastLook) paintPreview(preview, lastLook, mediaUrl || undefined);
  });
  const base64 = (f: File) => new Promise<string>((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result).replace(/^data:[^,]*,/, ''));
    r.onerror = () => reject(r.error);
    r.readAsDataURL(f);
  });

  const paint = (look: Described | null, near: { id: string; name: string; source: string; distance: number; chips?: string[] }[] = []) => {
    lastLook = look;
    $('f-media-field').hidden = !look?.media;
    $('live-empty').hidden = !!look;
    preview.hidden = !look;
    $('live-contrast').replaceChildren();
    $('live-font').textContent = look ? fontLine(look) : '';
    const list = $('live-near');
    list.replaceChildren();
    if (!look) { list.append(el('li', 'None yet.', 'help')); return; }
    paintPreview(preview, look, mediaUrl || undefined);
    for (const c of Array.isArray(look.contrast) ? look.contrast : []) {
      const li = el('li', `${c.label}: ${Number(c.ratio).toFixed(2)}:1`, c.pass ? 'pass' : 'fail');
      li.append(el('span', c.pass ? ` (needs ${c.min}:1, passes)` : ` (needs ${c.min}:1)`));
      $('live-contrast').append(li);
    }
    for (const n of near) {
      const li = el('li');
      const chips = el('span', '', 'look-chips');
      for (const c of (n.chips || []).filter((x) => /^#[0-9a-f]{6}$/i.test(x))) { const i = el('i'); i.style.setProperty('background', c); chips.append(i); }
      const a = /^[a-z0-9-]+$/.test(n.id) ? link(`/glaze/looks#${n.id}`, n.name) : el('span', n.name);
      li.append(chips, a, el('span', ` · ${n.source === 'community' ? 'community' : 'curated'} · distance ${Number(n.distance).toFixed(1)}`, 'help'));
      list.append(li);
    }
  };
  paint(null);

  // A code in the link (#code=…, how Glaze can open this page): filled in, but nothing is sent until the student asks.
  const hash = new URLSearchParams(location.hash.slice(1));
  if (hash.get('code')) {
    code.value = hash.get('code')!.slice(0, 20000);
    $('f-code-prefilled').hidden = false;
    $('f-code-check').addEventListener('click', () => { $('f-code-prefilled').hidden = true; check(); });
  }

  // ---- submitting -----------------------------------------------------------------------------------------------------
  const numbers = (n: { safe: number; quality: number; unique: string; distinct: number }) =>
    el('p', `The review's numbers: right for students ${pct(n.safe)}, quality ${Number(n.quality).toFixed(1)} of 4, ${pct(n.distinct)} distinct (${n.unique}).`, 'help');
  const statusLink = (token: string) => {
    const href = `/glaze/looks/submit#status=${encodeURIComponent(token)}`;
    const p = el('p', 'Keep this link to see what happens: ');
    p.append(link(href, `${location.origin}${href}`));
    return p;
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (reviewing) return;
    const file = needsFile() ? mediaInput.files?.[0] : undefined;
    const cap = lastLook?.media?.type === 'video' ? 12 : lastLook?.media?.type === 'image' ? 6 : 1;
    const missing = [!code.value.trim() && 'paste your theme code', !name.value.trim() && 'give it a name', !credit.value.trim() && 'say how to credit you', !license.checked && 'you need to agree to share it under CC BY 4.0', needsFile() && !file && 'add the background file this Look names', file && file.size > cap * 1024 ** 2 && `the background file is too big (the most is ${cap} MiB)`].filter(Boolean) as string[];
    if (missing.length) { showProblems(missing.map((m) => m.replace('give it a name', 'the name is missing: give it a name'))); form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }
    reviewing = true; ++seq; clearTimeout(timer);
    $('check-status').textContent = '';
    const button = $<HTMLButtonElement>('f-submit');
    button.disabled = true;
    button.textContent = 'Reviewing…';
    say(el('p', 'Reviewing your Look. This takes a few seconds.'));
    let r: Response;
    try {
      const media = file ? await base64(file) : undefined;
      r = await fetch(`${API}/submit`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code: code.value.trim(), name: name.value, credit: credit.value, tags: tags(), license: license.checked, ...(media && { media }) }) });
    } catch { closed(); return done(); }
    const body = await r.json().catch(() => ({}));
    if (r.status === 422) {
      showProblems(Array.isArray(body.problems) ? body.problems.map(String) : []);
      say(el('p', 'Fix the problems marked below; nothing was used up.'));
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    } else if (r.status === 429) {
      const when = typeof body.resets === 'string' ? new Date(body.resets).toLocaleString([], { weekday: 'long', hour: 'numeric', minute: '2-digit' }) : 'tomorrow';
      say(el('p', `${String(body.error || 'You can submit one Look a day.')} You can submit again ${when}.`));
    } else if (r.status === 413) {
      say(el('p', 'That background file is too big for the gallery. Glaze takes a video up to 12 MiB, an animated picture up to 6 MiB and a Lottie animation up to 1 MiB.'));
    } else if (r.status === 503) {
      say(el('p', String(body.error || 'Reviews are paused right now; nothing was used up. Try again later.')), link(issue, 'Share through a GitHub issue instead'));
    } else if (!r.ok) {
      closed();
    } else if (body.outcome === 'published') {
      const p = el('p', 'Published. ');
      p.append(link(String(body.url).startsWith('/glaze/looks#') ? body.url : '/glaze/looks', 'See it in the gallery'), '.');
      say(el('h2', 'Your Look is in the gallery.', 'submit-h2'), p, ...(typeof body.review === 'string' && body.review ? [el('p', `The second reviewer: ${body.review}`)] : []), numbers(body.numbers), ...(body.dropped?.length ? [el('p', `Left off: ${body.dropped.join(', ')} (the review didn't see it that way).`, 'help')] : []), statusLink(body.token));
    } else if (body.outcome === 'pending') {
      say(el('h2', 'A person will look at it.', 'submit-h2'), el('p', needsFile() ? 'A Look with a background file always goes to the maintainer, who looks at the file. The gallery holds your name, code and file until then.' : 'The automated review wasn\'t sure, so it went to the maintainer. It holds your name and code until then.'), numbers(body.numbers), statusLink(body.token));
    } else {
      const ul = el('ul', '', 'submit-reasons');
      for (const reason of Array.isArray(body.reasons) ? body.reasons : []) ul.append(el('li', String(reason)));
      say(el('h2', 'Not this time.', 'submit-h2'), ul, numbers(body.numbers), el('p', 'You can change it and submit again tomorrow.', 'help'));
    }
    done();
  });
  const done = () => { reviewing = false; const b = $<HTMLButtonElement>('f-submit'); b.disabled = false; b.textContent = 'Submit for review'; };

  $<HTMLButtonElement>('f-submit').disabled = false;

  // ---- #status=<token>: what became of a submission -----------------------------------------------------------------
  const token = hash.get('status');
  if (token && /^[\w-]{32}$/.test(token)) {
    fetch(`${API}/status/${token}`).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then((s) => {
      const title = el('h2', '', 'submit-h2');
      title.textContent = `“${String(s.name)}”: ${s.status === 'published' ? 'published' : s.status === 'pending' ? 'waiting for a person' : s.status === 'declined' ? 'declined' : 'taken down'}`;
      const out: Node[] = [title];
      if (s.status === 'published') { const p = el('p'); p.append(link(String(s.url).startsWith('/glaze/looks#') ? s.url : '/glaze/looks', 'See it in the gallery'), '.'); out.push(p); }
      if (s.status === 'declined' && s.reason) out.push(el('p', `The reason: ${String(s.reason)}`));
      if (s.status === 'pending') out.push(el('p', 'Check back later; this link keeps working.'));
      say(...out);
    }, (status) => say(el('p', status === 404 ? 'That status link is unknown, or its Look was declined more than 30 days ago.' : 'The gallery server isn\'t answering; try the link again later.')));
  }
</script>
