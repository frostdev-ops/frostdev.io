---
import releaseInfo from '../data/glazeRelease.json';
const { version, updated, changes } = releaseInfo;
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { existsSync } from 'node:fs';
import GlazeMedia from '../components/marketing/GlazeMedia.astro';
import GlazeChangelog from '../components/marketing/GlazeChangelog.astro';
import { availableFilms } from '../data/glazeFilms';
import '../styles/products.css';

// Set false to remove the entire Thanksgiving skin, decorations, and seasonal copy.
const thanksgiving = true;
// Harvest Moon, Turkey Trot and Hearthside are built in from Glaze 4.0.8; before it, the season's Looks are the gallery's.
const builtIn = version.localeCompare('4.0.8', undefined, { numeric: true }) >= 0;
const art = '/projects/glaze/thanksgiving';
const source = 'https://github.com/frostdev-ops/glaze';
const safariDownload = `${source}/releases/download/v${version}/glaze-${version}-safari-macos.dmg`;
const safariZip = `${source}/releases/download/v${version}/glaze-${version}-safari-macos.zip`;
const chromeZip = `${source}/releases/download/v${version}/glaze-v${version}.zip`;
const firefoxZip = `${source}/releases/download/v${version}/glaze-v${version}-firefox.zip`;
// glaze-mcp's Claude Desktop bundle, attached to each Glaze release under that release's version.
const agentBundle = `${source}/releases/download/v${version}/glaze-mcp-${version}.mcpb`;
const chromeStore = 'https://chromewebstore.google.com/detail/glaze-for-blackboard-ultra/jmmaeoajomodnbnlmdikjooalmcilooh';
const firefoxStore = 'https://addons.mozilla.org/en-US/firefox/addon/glaze/';
const films = availableFilms((file) => existsSync(`public/projects/glaze/${file}`));
---

<MarketingLayout title={`Glaze ${version} — Blackboard, Canvas and Moodle, made yours`} description="Make your school site yours: themes, glass and frost controls, papers, spreadsheets, PDFs and decks, animated pets, live course tabs, notes and planning. Free for Chrome, Safari and Firefox." path="/glaze" image="/projects/glaze/cover.webp">
  <div class:list={["product-page glaze-page", { "is-thanksgiving": thanksgiving }]}>
    <section class="product-hero" aria-labelledby="glaze-title">
      {thanksgiving && <div class="thanksgiving-hero" aria-hidden="true">
        <img class="thanksgiving-garland" src={`${art}/garland.webp`} width="1024" height="256" alt="" />
        {[0, 1, 2, 3, 4, 5, 6].map((i) => <span class={`thanksgiving-leaf leaf-${i}`}></span>)}
        <img class="thanksgiving-cornucopia" src={`${art}/cornucopia.webp`} width="640" height="437" alt="" />
        <img class="thanksgiving-wheat" src={`${art}/wheat.webp`} width="300" height="487" alt="" />
      </div>}
      <div class="product-intro">
        <p class="product-eyebrow">Glaze · Blackboard Ultra · Canvas · Moodle</p>
        <img class="product-logo" src="/projects/glaze-logo.svg" width="420" height="120" alt="Glaze" />
        <h1 class="product-title" id="glaze-title">Your courses.<br /><span>Your space.</span></h1>
        <p class="product-lead">Themes, animated backgrounds, study tools, and your papers, spreadsheets, PDFs and decks, on Blackboard Ultra, Canvas and Moodle. Build a Dashboard that works the way you do.</p>
        <div class="product-actions" data-glaze-install="safari">
          <a class="product-button" href={safariDownload}>Download for Safari on Mac <span aria-hidden="true">↓</span></a>
          <a class="product-button secondary" href="/guides/glaze-safari">Safari guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-actions" data-glaze-install="chrome">
          <a class="product-button" href={chromeStore}>Get from Chrome Web Store <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href="/guides/glaze-chrome">Chrome guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-actions" data-glaze-install="firefox">
          <a class="product-button" href={firefoxStore}>Get from Firefox Add-ons <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href="/guides/glaze-chrome#firefox">Firefox guide <span aria-hidden="true">→</span></a>
        </div>
        <nav class="hero-galleries" aria-label="Glaze galleries">
          <a class="hero-gallery" href="/glaze/looks">
            <span class="gallery-icon gallery-swatches" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="gallery-copy"><strong>Looks gallery</strong><span>Themes, palettes and backgrounds.</span></span>
            <span class="gallery-arrow" aria-hidden="true">→</span>
          </a>
          <a class="hero-gallery" href="/glaze/mods">
            <span class="gallery-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M17.5 13v9M13 17.5h9" /></svg></span>
            <span class="gallery-copy"><strong>Mods gallery</strong><span>Widgets, effects and page tweaks.</span></span>
            <span class="gallery-arrow" aria-hidden="true">→</span>
          </a>
        </nav>
        {thanksgiving && <p class="thanksgiving-note">{builtIn
          ? <>Thanksgiving Looks Harvest Moon, Turkey Trot and Hearthside each have their own animated scene.</>
          : <>Thanksgiving Looks Harvest Gathering and Home for Thanksgiving are in the <a href="/glaze/looks">Looks gallery</a>.</>}<br />Something warm for your study space.</p>}
        <p class="product-meta">Free and open source<br />Chrome, Safari and Firefox packages {version}<br />No analytics. No account.</p>
        <p class="product-caption"><a href="#browser-heading">See all browser downloads →</a></p>
        {films.length > 0 && <a class="hero-film-link" href="#films"><span aria-hidden="true">▶</span> See Glaze in motion <span aria-hidden="true">↗</span></a>}
      </div>
      <figure class="glaze-preview">
        <a href={films.length > 0 ? '#films' : '/projects/glaze/cover.webp'} aria-label={films.length > 0 ? `Explore all ${films.length} Glaze films` : 'Open the Glaze artwork'}><img src="/projects/glaze/cover.webp" width="1280" height="800" fetchpriority="high" alt="Glaze: Blackboard. Made yours. Cyan glaze flows around an illustrated course window with due-date and submitted badges." /></a>
        <figcaption><span>Better looks. Less friction.</span>{films.length > 0 && <a href="#films">Explore the films <span aria-hidden="true">→</span></a>}</figcaption>
      </figure>
    </section>

    <section class="glaze-promise" aria-labelledby="promise-heading">
      <div><p class="product-eyebrow">No Pro. No telemetry. No data sales.</p><h2 id="promise-heading">Free isn't a trial.<br />Privacy isn't an upsell.</h2><p>Glaze will stay free, with no paid feature gates. Your coursework stays out of our analytics—because we don't have any. Optional encrypted sharing is your choice.</p></div>
      <div class="promise-links"><a class="product-button" href="/glaze/privacy">Our privacy promise <span aria-hidden="true">→</span></a><a class="product-text-link" href="/glaze/terms">Read the terms</a></div>
    </section>

    {films.length > 0 && <div class="glaze-films">
      {thanksgiving && <div class="thanksgiving-turkey" aria-hidden="true"><img src={`${art}/turkey.webp`} width="480" height="463" loading="lazy" alt="" /></div>}
      <GlazeMedia films={films} />
    </div>}

    <section class="product-section product-split" aria-labelledby="writer-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Documents</p>
        <h2 id="writer-heading">Every document,<br />in one place.</h2>
        <p>Write papers in Blank, MLA, APA or Chicago. Use a spreadsheet grid with 380+ Excel functions and charts. Zoom, find and fill supported forms in PDFs, or read and present PowerPoint decks. Bring in Word, Excel, CSV, PDF and PowerPoint files. Blackboard’s file previews open in Glaze’s PDF viewer. Open Documents with Ctrl+K inside Blackboard, Canvas or Moodle. Everything stays on your device, keeps its versions, wears your Look, and waits 30 days in Trash if you delete it.</p>
      </div>
      <figure class="product-panel editor-preview">
        <a href="/projects/glaze/writer-documents.webp" aria-label="Open the full-size Documents capture"><img src="/projects/glaze/writer-documents.webp" width="1440" height="1000" loading="lazy" alt="Glaze’s Documents page in the Lagoon Look: New tiles for Blank, MLA 9, APA 7, Chicago 17 and Spreadsheet, and a grid of fictional papers, a spreadsheet, a fillable PDF and a slide deck with first-page thumbnails" /></a>
      </figure>
      <div class="writer-shots suite-shots">
        <figure class="product-panel editor-preview">
          <a href="/projects/glaze/writer-sheet.webp" aria-label="Open the full-size spreadsheet capture"><img src="/projects/glaze/writer-sheet.webp" width="1440" height="1000" loading="lazy" alt="A fictional plant-growth lab spreadsheet in Glaze: =AVERAGE(B2:B9) in the formula bar and a line chart of growth in sunlight and shade drawn on the grid" /></a>
        </figure>
        <figure class="product-panel editor-preview">
          <a href="/projects/glaze/writer-pdf.webp" aria-label="Open the full-size PDF capture"><img src="/projects/glaze/writer-pdf.webp" width="1440" height="1000" loading="lazy" alt="A fictional field trip permission form open in Glaze’s PDF viewer, its fields part-filled" /></a>
        </figure>
        <figure class="product-panel editor-preview">
          <a href="/projects/glaze/writer-slides.webp" aria-label="Open the full-size slides capture"><img src="/projects/glaze/writer-slides.webp" width="1440" height="1000" loading="lazy" alt="A fictional Cell Biology deck in Glaze’s slide reader, with the slide rail, Notes and Present, and the speaker notes under the slide" /></a>
        </figure>
      </div>
    </section>

    <section class="product-section" aria-labelledby="write-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">In Blackboard Ultra</p>
        <h2 id="write-heading">Write where you<br />hand it in.</h2>
        <p>Writer takes the place of Ultra’s editor in discussions, journals, messages, assignments and tests. Blackboard’s own editor is one click away in its ⋯ menu.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Discussions and messages</h3><p>A toolbar on selected text, the prompt’s word target and sources, and quotes from classmates’ posts. Blackboard’s own Post, Reply and Send still send it.</p></article>
        <article class="product-card"><h3>Papers on real pages</h3><p>Assignments open in a compact box whose text goes into Blackboard’s. Turn on Full writer for pages, footnotes, versions and MLA 9, APA 7 or Chicago 17 checks, then hand in a .docx from the submit sheet, through Blackboard’s upload. With Spreadsheets on, an empty attempt offers Document or Spreadsheet. Upload a PDF, deck or spreadsheet and choose Open in Glaze or Submit as is. From Glaze, submit the saved PDF, original deck or .xlsx.</p></article>
        <article class="product-card"><h3>Your words, checked</h3><p>Spelling and grammar are checked on your device, and sure typos are fixed as you type, each with its own undo. AI is optional and off until you set it up: Tab finishes only the sentence you’re writing, and Feedback checks your draft against the rubric and instructions. Glaze never drafts for you. Tests get proofing only.</p></article>
      </div>
      <div class="writer-shots">
        <figure class="product-panel editor-preview">
          <a href="/projects/glaze/writer-paper.webp" aria-label="Open the full-size Full writer capture"><img src="/projects/glaze/writer-paper.webp" width="1440" height="1000" loading="lazy" alt="Glaze Writer in Full writer on a fictional Blackboard Ultra assignment: an MLA 9 paper on a white page, with a spelling card offering receive for recieve, beside Glaze’s navigation" /></a>
        </figure>
        <figure class="product-panel editor-preview">
          <a href="/projects/glaze/writer-compose.webp" aria-label="Open the full-size discussion reply capture"><img src="/projects/glaze/writer-compose.webp" width="1440" height="1000" loading="lazy" alt="Glaze Writer in place of Blackboard Ultra’s editor in a fictional discussion: a selection toolbar over the draft and a word ring at 92 of 250, above Blackboard’s own Save Draft, Cancel and Post" /></a>
        </figure>
      </div>
    </section>

    <section class="product-section" aria-labelledby="agents-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Agents</p>
        <h2 id="agents-heading">Every app and every change<br />needs your OK.</h2>
        <p>Connect AI apps on your computer, like Claude Desktop, to your courses, to-dos, grades and Writer documents. Agents is off until you turn it on in Settings → AI → Agents.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Every app asks first</h3><p>An app sees nothing until you allow it in Glaze’s own window, one group at a time: courses, to-dos and schedule; grades; assignments and rubrics; Writer documents; a mod’s tools. Revoke it in Settings whenever you like.</p></article>
        <article class="product-card"><h3>Every change waits for you</h3><p>Marking a to-do done, a Writer fix or a citation happens only after your OK, shown in Glaze’s own words. Glaze’s built-in agent tools never submit work, post or send messages.</p></article>
        <article class="product-card"><h3>Stays on your computer</h3><p>Apps reach Glaze through a helper on your own computer that opens no network connections, and Glaze sends nothing to Frostdev. The app you connect may send what it gets to its own AI service, under its own policy.</p></article>
      </div>
      <p class="product-caption">Chrome, Edge, Brave, Vivaldi, Chromium and Firefox work on macOS, Windows and Linux with Node.js 18 or later: run <code>npx glaze-mcp setup</code>, or open the <a class="glaze-inline-link" href={agentBundle}>app bundle</a> in Claude Desktop. Safari uses the <a class="glaze-inline-link" href={safariDownload}>Glaze Mac app from the disk image</a> as its helper; the Mac App Store app has no agent access. Follow the <a class="glaze-inline-link" href="/guides/glaze-agents">Agents guide</a> to connect your app.</p>
    </section>

    <section class="product-section" aria-labelledby="features-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">What it does</p>
        <h2 id="features-heading">Better looking.<br />Easier to use.</h2>
        <p>Every helper can be switched off. Free Looks to try are in the <a class="glaze-inline-link" href="/glaze/looks">Looks gallery</a>, and add-ons in the <a class="glaze-inline-link" href="/glaze/mods">Mods gallery</a>.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">01</span><h3>Blackboard Ultra</h3><ul class="glaze-list">
          <li><strong>Your Dashboard:</strong> arrange notes, an agenda, a focus timer and Better To Do.</li>
          <li><strong>Course cards as widgets:</strong> add them to Courses or your Dashboard, then move, resize and fold them.</li>
          <li><strong>Live course tabs:</strong> keep up to four additional course pages live while you switch.</li>
          <li><strong>Find and focus:</strong> search inside courses and hide folders locally, with Undo.</li>
          <li><strong>Your navigation:</strong> a rail or top bar with your own links, icons and order.</li>
          <li><strong>Glaze Writer:</strong> posts, messages and papers in Glaze’s editor, with Blackboard’s one click away.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">02</span><h3>Canvas</h3><ul class="glaze-list">
          <li><strong>Better To Do:</strong> tasks, steps, “do on” days and focus sessions.</li>
          <li><strong>Dashboard widgets:</strong> notes, agenda, timer and a study buddy, arranged your way.</li>
          <li><strong>What-if grades:</strong> try scores against Canvas’s rules, with estimates labelled when totals don’t match.</li>
          <li><strong>Course tools:</strong> search, module previews, your place and folder downloads.</li>
          <li><strong>Local imports:</strong> review a class schedule, syllabus or past GPA terms before saving.</li>
          <li><strong>Documents:</strong> papers, spreadsheets, PDFs and decks, a Ctrl+K away.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">03</span><h3>Moodle</h3><ul class="glaze-list">
          <li><strong>The same theme:</strong> Looks, palettes, fonts and backgrounds on Boost pages.</li>
          <li><strong>Across your day:</strong> Dashboard, My courses, activities, grades, calendar and messages.</li>
          <li><strong>Course totals:</strong> grades on cards, as Moodle makes them available.</li>
          <li><strong>Due this week:</strong> your Timeline in the popup and command palette.</li>
          <li><strong>A Look per course:</strong> tint, course menus and keyboard shortcuts.</li>
          <li><strong>Documents:</strong> papers, spreadsheets, PDFs and decks, a Ctrl+K away.</li>
        </ul></article>
      </div>
      <p class="product-caption"><strong>Since 3.3.0:</strong> Canvas and Blackboard Ultra share a resizable sidebar: <strong>This page</strong> keeps the page’s own tools above the <strong>My widgets</strong> dock. It makes room beside your work on wide screens and opens as a drawer on narrow ones. Better To Do follows the current course, with an <strong>All courses</strong> option. Move compatible widgets between the sidebar, Dashboard and floating.</p>
      <p class="product-caption">Moodle support targets Boost on Moodle 5 and compatible 4.x pages. Its helpers differ from Canvas and Ultra; the guides explain each site. Glaze never changes your real grades, and nothing is posted or submitted until you press Post, Reply, Send or Submit.</p>
    </section>

    <section class="product-section" aria-labelledby="changelog-heading">
      <GlazeChangelog version={version} updated={updated} changes={changes} notes={`${source}/releases/tag/v${version}`} />
    </section>

    <section class="product-section" aria-labelledby="study-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">More room to study</p>
        <h2 id="study-heading">Keep the tools you need.</h2>
        <p>On Canvas and Ultra, make room for your work without adding another account.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Plan on your device</h3><p>Better To Do brings due work and your own tasks together. Add plans and focus sessions, import a timetable, or export a calendar file. Reminders, streaks and term Insights are there when you turn them on.</p></article>
        <article class="product-card"><h3>Notes that stay with you</h3><p>Use rich-text notes with pictures, attachments and course folders. Search your notes, link school content, and export Markdown, HTML or a backup of everything.</p></article>
        <article class="product-card"><h3>Share by invitation</h3><p>Optional end-to-end encrypted sessions share selected notes and tasks by link. Use your chosen relay or <a href={`${source}/blob/main/server/README.md`}>host your own</a>. Glaze works fully without sharing or a server.</p></article>
      </div>
    </section>

    <section class="product-section" aria-labelledby="personal-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">A space that feels like you</p>
        <h2 id="personal-heading">A little frost.<br />A little company.</h2>
        <p>Shape the panels around your work and pick a companion for your study space.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Glass, color and texture</h3><p>In <strong>Look → Shape and surfaces</strong>, adjust opacity, blur, tint, shadows, frost and borders across Blackboard Ultra, Canvas and Moodle. Match your accent or course color, with rounded corners that follow your Look.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#surfaces">Shape your surfaces →</a></article>
        <article class="product-card"><h3>Choose your study companion</h3><p>Meet Ember, Luna, Mochi, Sprout, Pebble, Rime and the Glaze droplet, or import a pet sprite sheet from your device. Choose once for the habitat, Study buddy, Blackboard navigation badge and course-card pet, including the original Cat and Bunny. Keep leveling across semesters, decorate four habitats, play with draggable toys and settle on calm favorite perches. Preferences learn locally from numeric interaction signals; typed text and page content are not training data. You can disable or reset learning. XP and decorations stay with your school account. No uploads, nags or missed-day penalties.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#pets">Meet the pets →</a></article>
        <article class="product-card"><h3>Live course tabs</h3><p>Keep up to four additional course pages live on every computer; hidden pages no longer close just because they have been idle.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#workspace">Set up your workspace →</a></article>
      </div>
      <p class="product-caption"><strong>Mods:</strong> add backgrounds (shaders, layered scenes, videos, animated pictures, Lottie), motion and event effects, nav layouts, page tweaks, and sticker and pet packs and widgets made by others, from a code, link, file or the gallery's Mods section. Each mod shows what it may read, and why, before you add it. Code mods run sandboxed on Chrome; Firefox and Safari get mods without code. Updates are signed, with an opt-out signed blocklist, and a no-code widget builder makes your own. Looks can now have a looping video, animated WebP/AVIF or Lottie background, muted, still when motion is off and paused in hidden tabs. See the <a href="/guides/glaze-mods-api">mods guide</a>.</p>
    </section>

    <section class="product-section product-split" aria-labelledby="editor-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">The editor</p>
        <h2 id="editor-heading">See it as you shape it.</h2>
        <p>Quick switches in the popup. Eleven settings categories, search across every setting and a live preview for each school site. Shape your surfaces, check the result, and reset any control without starting over.</p>
      </div>
      <figure class="product-panel editor-preview">
        <a href="/projects/glaze-surfaces-4.0.0.webp" aria-label="Open the full-size Glaze settings capture"><img src="/projects/glaze-surfaces-4.0.0.webp" width="1440" height="1000" loading="lazy" alt="Glaze settings, Look → Shape and surfaces with corner radius, glass blur, depth, surface opacity, tint, shadow, frost and border controls, beside a live preview of a fictional Blackboard Ultra course outline" /></a>
      </figure>
    </section>

    <section class="product-section" aria-labelledby="browser-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Install</p>
        <h2 id="browser-heading">Choose your browser.</h2>
      </div>
      <div class="browser-guides">
        <a class="product-panel browser-guide" href="/guides/glaze-safari"><span class="product-eyebrow">Safari on Mac</span><h3>Signed, notarized Mac app.</h3><p>Install Glaze {version}, enable the extension, allow your Blackboard, Canvas or Moodle site.</p><span class="product-text-link">Safari guide →</span></a>
        <a class="product-panel browser-guide" href="/guides/glaze-chrome"><span class="product-eyebrow">Chrome</span><h3>Store or GitHub package.</h3><p>The store version may differ. Load the GitHub package unpacked for Glaze {version}, as this guide explains.</p><span class="product-text-link">Chrome guide →</span></a>
        <a class="product-panel browser-guide" href={firefoxStore}><span class="product-eyebrow">Firefox</span><h3>Install from Firefox Add-ons.</h3><p>Firefox Add-ons shows the currently approved version for Firefox 140 or newer on desktop and Firefox 142 or newer on Android. Install once and receive updates through Firefox.</p><span class="product-text-link">Get Glaze for Firefox ↗</span></a>
      </div>
      <p class="product-caption"><a href="/guides/glaze-chrome#firefox">Firefox installation guide</a>. GitHub downloads: <a class="glaze-inline-link" href={safariDownload}>Safari Mac app ({version}, .dmg)</a> · <a href={safariZip}>Safari Mac ZIP ({version})</a> · <a href={chromeZip}>Chrome extension ZIP ({version})</a> · <a href={firefoxZip}>Firefox development ZIP ({version})</a> · <a href={`${source}/releases/tag/v${version}`}>{version} release notes</a>. Chrome Web Store versions may differ; Firefox Add-ons shows the currently approved version.</p>
    </section>

    <section class="product-cta">
      {thanksgiving && <div class="thanksgiving-pie" aria-hidden="true"><img src={`${art}/pie.webp`} width="480" height="345" loading="lazy" alt="" /></div>}
      {thanksgiving && <div class="thanksgiving-leaves" aria-hidden="true"><img src={`${art}/leaves.webp`} width="480" height="463" loading="lazy" alt="" /></div>}
      <p class="product-eyebrow">Glaze by Frostdev</p>
      <h2>Your theme. Your data.</h2>
      <p>No analytics. No account. Your work stays on your device until you post it, submit it, share it or send it to an AI you set up. Encrypted sharing uses an optional relay.</p>
      <div class="product-actions"><a class="product-button" href={source}>View source <span aria-hidden="true">↗</span></a><a class="product-button secondary" href="/glaze/privacy">Privacy policy <span aria-hidden="true">→</span></a><a class="product-button secondary" href="/glaze/terms">Terms <span aria-hidden="true">→</span></a></div>
      <p class="product-caption">Blackboard is a trademark of Anthology Inc. Canvas is a trademark of Instructure, Inc. Glaze is an independent project and is not affiliated with or endorsed by Blackboard, Canvas or Moodle.</p>
    </section>
  </div>
</MarketingLayout>

<script>
  const ua = navigator.userAgent;
  const mobile = /Android|iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const otherBrowser = /Edg|OPR|Firefox|FxiOS|CriOS/.test(ua);
  const browser = /Firefox\//.test(ua) && !/FxiOS/.test(ua) ? 'firefox'
    : !mobile && !otherBrowser && /Chrome\//.test(ua) ? 'chrome'
    : !mobile && !otherBrowser && /Macintosh/.test(ua) && /Safari\//.test(ua) && !/Chrome|Chromium/.test(ua) ? 'safari'
    : null;
  if (browser) {
    for (const links of document.querySelectorAll<HTMLElement>('[data-glaze-install]')) {
      links.hidden = links.dataset.glazeInstall !== browser;
    }
  }
</script>

