---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/products.css';

const source = 'https://github.com/frostdev-ops/glaze';
const safariDownload = `${source}/releases/download/v2.1.2/glaze-2.1.2-safari-macos.dmg`;
const chromeStore = 'https://chromewebstore.google.com/detail/glaze-for-blackboard-ultra/jmmaeoajomodnbnlmdikjooalmcilooh';
---

<MarketingLayout title="Glaze — Your colors on Blackboard Ultra" description="Glaze restyles Blackboard Ultra: one-click looks, your palette and fonts, animated backgrounds, due dates, new-grade badges, a what-if grade calculator, Ctrl+K search and Download all. For Safari and Chrome." path="/glaze" image="/projects/glaze-preview.webp">
  <div class="product-page glaze-page">
    <section class="product-hero" aria-labelledby="glaze-title">
      <div class="product-intro">
        <p class="product-eyebrow">Glaze · Blackboard Ultra</p>
        <img class="product-logo" src="/projects/glaze-logo.svg" width="420" height="120" alt="Glaze" />
        <h1 class="product-title" id="glaze-title">Your courses.<br />Your colors.</h1>
        <p class="product-lead">Blackboard Ultra, restyled your way, with the things it should have shown you all along.</p>
        <div class="product-actions" data-glaze-install="safari">
          <a class="product-button" href={safariDownload}>Download for Safari on Mac <span aria-hidden="true">↓</span></a>
          <a class="product-button secondary" href="/guides/glaze-safari">Safari guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-actions" data-glaze-install="chrome">
          <a class="product-button" href={chromeStore}>Get from Chrome Web Store <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href="/guides/glaze-chrome">Chrome guide <span aria-hidden="true">→</span></a>
        </div>
        <p class="product-meta">Version 2.1 · Free and open source · No analytics · No account</p>
      </div>
      <figure class="glaze-preview">
        <div class="preview-top"><span class="preview-dots" aria-hidden="true">● ● ●</span><span>Glaze · Course preview</span></div>
        <a href="/projects/glaze-preview.webp" aria-label="Open the full-size Glaze sample course preview"><img src="/projects/glaze-preview.webp" width="1000" height="1020" alt="Glaze’s Frost palette on its sample Blackboard Ultra course, with content and grade cards" /></a>
        <figcaption>Glaze’s own preview, sample course data.</figcaption>
      </figure>
    </section>

    <section class="product-section" aria-labelledby="features-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">What it does</p>
        <h2 id="features-heading">Better looking.<br />Easier to use.</h2>
        <p>Every helper can be switched off.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">01</span><h3>Make it yours</h3><ul class="glaze-list">
          <li><strong>Looks:</strong> eight ready-made themes, one click each.</li>
          <li><strong>Palettes:</strong> six presets or your own, light and dark.</li>
          <li><strong>Fonts:</strong> about 40, including dyslexia-friendly ones.</li>
          <li><strong>Backgrounds:</strong> eight animated scenes or a gradient.</li>
          <li><strong>Course tint:</strong> each course in its own color.</li>
          <li><strong>Theme codes:</strong> share your look as one line of text.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">02</span><h3>See what matters</h3><ul class="glaze-list">
          <li><strong>Due dates:</strong> countdowns, urgency and “Submitted late”.</li>
          <li><strong>Grades</strong> on course cards, plus score bars.</li>
          <li><strong>“New” badges</strong> on new grades and new content.</li>
          <li><strong>What-if calculator:</strong> the score you need on what’s left.</li>
          <li><strong>Folder previews</strong> and course progress.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">03</span><h3>Get there faster</h3><ul class="glaze-list">
          <li><strong>Ctrl+K / ⌘K:</strong> jump to any course, item or page.</li>
          <li><strong>Download all:</strong> a folder’s files as one zip.</li>
          <li><strong>Typing backup:</strong> your post survives a crash or timeout.</li>
          <li><strong>Focus mode</strong> and dark PDFs for reading.</li>
          <li><strong>Six languages</strong>, following Blackboard’s.</li>
        </ul></article>
      </div>
    </section>

    <section class="product-section product-split" aria-labelledby="editor-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">The editor</p>
        <h2 id="editor-heading">See it as you shape it.</h2>
        <p>Quick switches in the popup. Every setting, searchable, beside a live preview in the editor.</p>
      </div>
      <figure class="product-panel editor-preview">
        <a href="/projects/glaze-backgrounds.webp" aria-label="Open the full-size Glaze editor capture"><img src="/projects/glaze-backgrounds.webp" width="1280" height="800" loading="lazy" alt="Glaze’s editor with mesh gradient controls beside its live sample-course preview" /></a>
      </figure>
    </section>

    <section class="product-section" aria-labelledby="browser-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Install</p>
        <h2 id="browser-heading">Safari or Chrome.</h2>
      </div>
      <div class="browser-guides">
        <a class="product-panel browser-guide" href="/guides/glaze-safari"><span class="product-eyebrow">Safari on Mac</span><h3>Signed, notarized Mac app.</h3><p>Install, enable the extension, allow your Blackboard site.</p><span class="product-text-link">Safari guide →</span></a>
        <a class="product-panel browser-guide" href="/guides/glaze-chrome"><span class="product-eyebrow">Chrome</span><h3>Chrome Web Store.</h3><p>Add to Chrome and open Blackboard. The 2.1 update is in store review.</p><span class="product-text-link">Chrome guide →</span></a>
      </div>
    </section>

    <section class="product-cta">
      <p class="product-eyebrow">Glaze by Frostdev</p>
      <h2>Your theme. Your data.</h2>
      <p>No server, no analytics. Settings stay in your browser; Glaze never submits coursework.</p>
      <div class="product-actions"><a class="product-button" href={source}>View source <span aria-hidden="true">↗</span></a><a class="product-button secondary" href={`${source}/blob/main/PRIVACY.md`}>Privacy policy <span aria-hidden="true">↗</span></a></div>
      <p class="product-caption">For Blackboard Ultra. Not affiliated with or endorsed by Anthology Inc.</p>
    </section>
  </div>
</MarketingLayout>

<script>
  const ua = navigator.userAgent;
  const mobile = /Android|iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const otherBrowser = /Edg|OPR|Firefox|FxiOS|CriOS/.test(ua);
  const browser = !mobile && !otherBrowser && /Chrome\//.test(ua) ? 'chrome'
    : !mobile && !otherBrowser && /Macintosh/.test(ua) && /Safari\//.test(ua) && !/Chrome|Chromium/.test(ua) ? 'safari'
    : null;
  if (browser) {
    for (const links of document.querySelectorAll<HTMLElement>('[data-glaze-install]')) {
      links.hidden = links.dataset.glazeInstall !== browser;
    }
  }
</script>

<style>
  .glaze-page { --product-accent: #6fdcff; }
  .glaze-preview { min-width: 0; border: 1px solid #2b4b61; border-radius: 1rem; overflow: hidden; background: #060d18; animation: preview-arrive .8s ease-out both; }
  .preview-top { display: flex; align-items: center; gap: 1rem; padding: .85rem 1rem; color: #adc8db; font-size: .7rem; border-bottom: 1px solid #23394e; }
  .preview-dots { color: #40647c; letter-spacing: .2em; }
  .glaze-preview img, .editor-preview img { display: block; width: 100%; height: auto; }
  .glaze-preview figcaption { padding: .85rem 1rem; color: #8fa8c0; font-size: .72rem; line-height: 1.6; }
  .glaze-feature { display: block; margin-bottom: 1.25rem; color: #6fdcff; font-size: .75rem; }
  .editor-preview { padding: .75rem; }
  .glaze-list { display: grid; gap: .6rem; padding: 0; list-style: none; color: #b3c8dc; font-size: .9rem; line-height: 1.6; }
  .glaze-list strong { color: #e8f2fa; font-weight: 600; }
  .browser-guides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .browser-guide { transition: border-color .2s, transform .2s; }
  .browser-guide:hover { border-color: #6fdcff; transform: translateY(-3px); }
  .browser-guide .product-eyebrow { display: block; }
  @keyframes preview-arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 700px) { .browser-guides { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .glaze-preview { animation: none; } .browser-guide { transition: none; } .browser-guide:hover { transform: none; } }
</style>
