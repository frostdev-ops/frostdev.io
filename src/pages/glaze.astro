---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import GlazeMedia from '../components/marketing/GlazeMedia.astro';
import { films } from '../data/glazeFilms';
import '../styles/products.css';

// Set false to remove the entire Halloween skin, decorations, and seasonal copy.
const halloween = true;
const source = 'https://github.com/frostdev-ops/glaze';
const safariDownload = `${source}/releases/download/v3.3.0/glaze-3.3.0-safari-macos.dmg`;
const safariZip = `${source}/releases/download/v3.3.0/glaze-3.3.0-safari-macos.zip`;
const chromeZip = `${source}/releases/download/v3.3.0/glaze-v3.3.0.zip`;
const firefoxZip = `${source}/releases/download/v3.3.0/glaze-v3.3.0-firefox.zip`;
const chromeStore = 'https://chromewebstore.google.com/detail/glaze-for-blackboard-ultra/jmmaeoajomodnbnlmdikjooalmcilooh';
---

<MarketingLayout title="Glaze 3.3.0 — Blackboard, Canvas and Moodle, made yours" description="Make your school site yours: themes, glass and frost controls, animated pets, live course tabs, notes and planning. Free for Chrome and Safari, with a Firefox preview." path="/glaze" image="/projects/glaze/cover.webp">
  <div class:list={["product-page glaze-page", { "is-halloween": halloween }]}>
    <section class="product-hero" aria-labelledby="glaze-title">
      {halloween && <div class="halloween-hero" aria-hidden="true">
        <span class="halloween-moon"></span>
        <img class="halloween-bat bat-one" src="/projects/glaze/halloween/bat.svg" width="240" height="140" alt="" />
        <img class="halloween-bat bat-two" src="/projects/glaze/halloween/bat.svg" width="240" height="140" alt="" />
        <img class="halloween-bat bat-three" src="/projects/glaze/halloween/bat.svg" width="240" height="140" alt="" />
        <span class="halloween-fog"></span>
        <div class="halloween-pumpkins">
          <img src="/projects/glaze/halloween/pumpkin.svg" width="200" height="200" alt="" />
          <img src="/projects/glaze/halloween/jack-o-lantern.svg" width="200" height="200" alt="" />
          <img src="/projects/glaze/halloween/pumpkin.svg" width="200" height="200" alt="" />
        </div>
      </div>}
      <div class="product-intro">
        <p class="product-eyebrow">Glaze · Blackboard Ultra · Canvas · Moodle</p>
        <img class="product-logo" src="/projects/glaze-logo.svg" width="420" height="120" alt="Glaze" />
        <h1 class="product-title" id="glaze-title">Your courses.<br /><span>Your space.</span></h1>
        <p class="product-lead">Themes, animated backgrounds and study tools for Blackboard Ultra, Canvas and Moodle. Build a Dashboard that works the way you do.</p>
        <div class="product-actions" data-glaze-install="safari">
          <a class="product-button" href={safariDownload}>Download for Safari on Mac <span aria-hidden="true">↓</span></a>
          <a class="product-button secondary" href="/guides/glaze-safari">Safari guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-actions" data-glaze-install="chrome">
          <a class="product-button" href={chromeStore}>Get from Chrome Web Store <span aria-hidden="true">↗</span></a>
          <a class="product-button secondary" href="/guides/glaze-chrome">Chrome guide <span aria-hidden="true">→</span></a>
        </div>
        {halloween && <p class="halloween-note">Halloween Looks Graveyard and Pumpkin Patch each have their own animated scene.<br />A little Halloween for your study space.</p>}
        <p class="product-meta">Free and open source<br />Chrome, Safari and Firefox 3.3.0<br />No analytics. No account.</p>
        <p class="product-caption"><a href="/guides/glaze-chrome#firefox">Try the Firefox preview →</a></p>
        <a class="hero-film-link" href="#films"><span aria-hidden="true">▶</span> See Glaze in motion <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="glaze-preview">
        <a href="#films" aria-label={`Explore all ${films.length} Glaze films`}><img src="/projects/glaze/cover.webp" width="1280" height="800" fetchpriority="high" alt="Glaze: Blackboard. Made yours. Cyan glaze flows around an illustrated course window with due-date and submitted badges." /></a>
        <figcaption><span>Better looks. Less friction.</span><a href="#films">Explore the films <span aria-hidden="true">→</span></a></figcaption>
      </figure>
    </section>

    <section class="glaze-promise" aria-labelledby="promise-heading">
      <div><p class="product-eyebrow">No Pro. No telemetry. No data sales.</p><h2 id="promise-heading">Free isn't a trial.<br />Privacy isn't an upsell.</h2><p>Glaze will stay free, with no paid feature gates. Your coursework stays out of our analytics—because we don't have any. Optional encrypted sharing is your choice.</p></div>
      <div class="promise-links"><a class="product-button" href="/glaze/privacy">Our privacy promise <span aria-hidden="true">→</span></a><a class="product-text-link" href="/glaze/terms">Read the terms</a></div>
    </section>

    <div class="glaze-films">
      {halloween && <div class="halloween-ghost" aria-hidden="true"><img src="/projects/glaze/halloween/ghost.svg" width="200" height="220" alt="" /></div>}
      <GlazeMedia halloween={halloween} />
    </div>

    <section class="product-section" aria-labelledby="features-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">What it does</p>
        <h2 id="features-heading">Better looking.<br />Easier to use.</h2>
        <p>Every helper can be switched off. Free Looks to try are in the <a class="glaze-inline-link" href="/glaze/looks">Looks gallery</a>, and add-ons in the <a class="glaze-inline-link" href="/glaze/mods">Mods gallery</a>.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">01</span><h3>Blackboard Ultra</h3><ul class="glaze-list">
          <li><strong>Your Dashboard:</strong> arrange notes, an agenda, a focus timer and Better To Do.</li>
          <li><strong>Course cards as widgets:</strong> add them to Courses or your Dashboard, then move, resize and fold them.</li>
          <li><strong>Live course tabs:</strong> keep up to four additional course pages live while you switch.</li>
          <li><strong>Find and focus:</strong> search inside courses and hide folders locally, with Undo.</li>
          <li><strong>Your navigation:</strong> custom links, icons, sizes and a rail that expands on hover or focus.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">02</span><h3>Canvas</h3><ul class="glaze-list">
          <li><strong>Better To Do:</strong> tasks, steps, “do on” days and focus sessions.</li>
          <li><strong>Dashboard widgets:</strong> notes, agenda, timer and a study buddy, arranged your way.</li>
          <li><strong>What-if grades:</strong> try scores against Canvas’s rules, with estimates labelled when totals don’t match.</li>
          <li><strong>Course tools:</strong> search, module previews, your place and folder downloads.</li>
          <li><strong>Local imports:</strong> review a class schedule, syllabus or past GPA terms before saving.</li>
        </ul></article>
        <article class="product-card"><span class="glaze-feature" aria-hidden="true">03</span><h3>Moodle</h3><ul class="glaze-list">
          <li><strong>The same theme:</strong> Looks, palettes, fonts and backgrounds on Boost pages.</li>
          <li><strong>Across your day:</strong> Dashboard, My courses, activities, grades, calendar and messages.</li>
          <li><strong>Course totals:</strong> grades on cards, as Moodle makes them available.</li>
          <li><strong>Due this week:</strong> your Timeline in the popup and command palette.</li>
          <li><strong>A Look per course:</strong> tint, course menus and keyboard shortcuts.</li>
        </ul></article>
      </div>
      <p class="product-caption"><strong>New in 3.3.0:</strong> Canvas and Blackboard Ultra share a resizable sidebar: <strong>This page</strong> keeps the page’s own tools above the <strong>My widgets</strong> dock. It makes room beside your work on wide screens and opens as a drawer on narrow ones. Better To Do moves there and follows the current course, with an <strong>All courses</strong> option. Move widgets between the sidebar, Dashboard and floating. <a href={`${source}/releases/tag/v3.3.0`}>Read the release notes</a>.</p>
      <p class="product-caption">Moodle support targets Boost on Moodle 5 and compatible 4.x pages. Its helpers differ from Canvas and Ultra; the guides explain each site. Glaze never submits coursework or changes your real grades.</p>
    </section>

    <section class="product-section" aria-labelledby="study-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">More room to study</p>
        <h2 id="study-heading">Keep the tools you need.</h2>
        <p>On Canvas and Ultra, make room for your work without adding another account.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Plan on your device</h3><p>Better To Do brings due work and your own tasks together. Add plans and focus sessions, import a timetable, or export a calendar file. Reminders, streaks and term Insights are there when you turn them on.</p></article>
        <article class="product-card"><h3>Notes that stay with you</h3><p>Opt into rich-text notes with pictures, attachments and course folders. Search your notes, link school content, and export Markdown, HTML or a backup of everything.</p></article>
        <article class="product-card"><h3>Share by invitation</h3><p>Optional end-to-end encrypted sessions share selected notes and tasks by link. Use your chosen relay or <a href={`${source}/blob/main/server/README.md`}>host your own</a>. Glaze works fully without sharing or a server.</p></article>
      </div>
    </section>

    <section class="product-section" aria-labelledby="personal-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">A space that feels like you</p>
        <h2 id="personal-heading">A little frost.<br />A little company.</h2>
        <p>Shape the panels around your work and pick a companion for your study space.</p>
      </div>
      <div class="product-grid">
        <article class="product-card"><h3>Glass, color and texture</h3><p>In <strong>Look → Surfaces</strong>, adjust opacity, blur, tint, shadows, frost and borders across Blackboard Ultra, Canvas and Moodle. Match your accent or course color, with rounded corners that follow your Look.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#surfaces">Shape your surfaces →</a></article>
        <article class="product-card"><h3>Choose your study companion</h3><p>Meet Ember, Luna, Mochi, Sprout, Pebble, Rime and the Glaze droplet, or import a pet sprite sheet from your device. Choose once for the habitat, Study buddy, Blackboard navigation badge and course-card pet, including the original Cat and Bunny. Keep leveling across semesters, decorate four habitats, play with draggable toys and settle on calm favorite perches. Preferences learn locally from numeric interaction signals; typed text and page content are not training data. You can disable or reset learning. XP and decorations stay with your school account. No uploads, nags or missed-day penalties.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#pets">Meet the pets →</a></article>
        <article class="product-card"><h3>Keep your place, keep moving</h3><p>Glaze 3.0.2 reduces Blackboard’s styling work during clicks, hovers and page changes. Keep up to four additional course pages live on every computer; hidden pages no longer close just because they have been idle.</p><a class="glaze-inline-link" href="/guides/glaze-chrome#workspace">Set up your workspace →</a></article>
      </div>
      <p class="product-caption"><strong>New in 3.0.4:</strong> mods. Add backgrounds (shaders, layered scenes, videos, animated pictures, Lottie), motion and event effects, nav layouts, page tweaks, and sticker and pet packs and widgets made by others, from a code, link, file or the gallery's new Mods section. Each mod shows what it may read, and why, before you add it. Code mods run sandboxed on Chrome; Firefox and Safari get mods without code. Updates are signed, with an opt-out signed blocklist, and a no-code widget builder makes your own. Looks can now have a looping video, animated WebP/AVIF or Lottie background, muted, still when motion is off and paused in hidden tabs. See the <a href="/guides/glaze-mods-api">mods guide</a>.</p>
    </section>

    <section class="product-section product-split" aria-labelledby="editor-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">The editor</p>
        <h2 id="editor-heading">See it as you shape it.</h2>
        <p>Quick switches in the popup. Eight editor tabs, search across every setting and a live preview for each school site. Shape your surfaces, check the result, and reset any control without starting over.</p>
      </div>
      <figure class="product-panel editor-preview">
        <a href="/projects/glaze-surfaces-3.0.2.webp" aria-label="Open the full-size Glaze editor capture"><img src="/projects/glaze-surfaces-3.0.2.webp" width="1440" height="1000" loading="lazy" alt="Glaze 3.0.2’s Surfaces editor with opacity, tint, frost, blur and shadow controls beside a fictional Blackboard course preview" /></a>
      </figure>
    </section>

    <section class="product-section" aria-labelledby="browser-heading">
      <div class="product-section-heading">
        <p class="product-eyebrow">Install</p>
        <h2 id="browser-heading">Choose your browser.</h2>
      </div>
      <div class="browser-guides">
        <a class="product-panel browser-guide" href="/guides/glaze-safari"><span class="product-eyebrow">Safari on Mac</span><h3>Signed, notarized Mac app.</h3><p>Install Glaze 3.3.0, enable the extension, allow your Blackboard, Canvas or Moodle site.</p><span class="product-text-link">Safari guide →</span></a>
        <a class="product-panel browser-guide" href="/guides/glaze-chrome"><span class="product-eyebrow">Chrome</span><h3>Store or GitHub package.</h3><p>The store version may differ. Load the GitHub package unpacked for the 3.3.0 features in this guide.</p><span class="product-text-link">Chrome guide →</span></a>
        <a class="product-panel browser-guide" href="/guides/glaze-chrome#firefox"><span class="product-eyebrow">Firefox preview</span><h3>Try the Firefox package.</h3><p>The 3.3.0 preview needs Firefox 140 or newer on desktop. Load it temporarily for this browser session; it is removed when Firefox quits.</p><span class="product-text-link">Firefox setup →</span></a>
      </div>
      <p class="product-caption">GitHub downloads: <a href={safariZip}>Safari Mac ZIP (3.3.0)</a> · <a href={chromeZip}>Chrome extension ZIP (3.3.0)</a> · <a href={firefoxZip}>Firefox preview ZIP (3.3.0)</a> · <a href={`${source}/releases/tag/v3.3.0`}>3.3.0 release notes</a>.</p>
    </section>

    <section class="product-cta">
      {halloween && <div class="halloween-skeleton" aria-hidden="true"><img src="/projects/glaze/halloween/skeleton.svg" width="200" height="260" alt="" /></div>}
      <p class="product-eyebrow">Glaze by Frostdev</p>
      <h2>Your theme. Your data.</h2>
      <p>No analytics. No account. Your work stays local unless you choose to share it. Encrypted sharing uses an optional relay; Glaze never submits coursework.</p>
      <div class="product-actions"><a class="product-button" href={source}>View source <span aria-hidden="true">↗</span></a><a class="product-button secondary" href="/glaze/privacy">Privacy policy <span aria-hidden="true">→</span></a><a class="product-button secondary" href="/glaze/terms">Terms <span aria-hidden="true">→</span></a></div>
      <p class="product-caption">Blackboard is a trademark of Anthology Inc. Canvas is a trademark of Instructure, Inc. Glaze is an independent project and is not affiliated with or endorsed by Blackboard, Canvas or Moodle.</p>
    </section>
  </div>
</MarketingLayout>

<script>
  const ua = navigator.userAgent;
  const mobile = /Android|iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const otherBrowser = /Edg|OPR|Firefox|FxiOS|CriOS/.test(ua);
  const browser = !mobile && !otherBrowser && /Chrome\//.test(ua) ? 'chrome'
    : !mobile && !otherBrowser && /Macintosh/.test(ua) && /Safari\//.test(ua) && !/Chrome|Chromium/.test(ua) ? 'safari'
    : null;
  if (browser) {
    for (const links of document.querySelectorAll<HTMLElement>('[data-glaze-install]')) {
      links.hidden = links.dataset.glazeInstall !== browser;
    }
  }
</script>

<style>
  .glaze-promise { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; padding: 2.5rem; margin-bottom: 3rem; border: 1px solid var(--glaze-line, #2b4b61); border-radius: 1rem; background: linear-gradient(120deg, #17413b55, #171127aa); }
  .glaze-promise > div:first-child { max-width: 36rem; }
  .glaze-promise h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); letter-spacing: -.04em; line-height: 1.15; margin-bottom: 1rem; }
  .glaze-promise p:not(.product-eyebrow) { color: var(--glaze-muted, #b3c8dc); font-size: .92rem; line-height: 1.8; }
  .promise-links { display: grid; justify-items: start; }
  @media (max-width: 700px) { .glaze-promise { padding: 1.5rem; } }
  .glaze-page { --product-accent: #6fdcff; }
  .product-hero { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 2.5rem; }
  .product-title span { color: var(--glaze-accent, #83e6f4); }
  .hero-film-link { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1.75rem; color: var(--glaze-accent-secondary, #a4e5f5); font-size: .8rem; }
  .hero-film-link > span:first-child { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--glaze-line, #36596c); border-radius: 50%; font-size: .6rem; }
  .glaze-preview { min-width: 0; border: 1px solid var(--glaze-line, #2b4b61); border-radius: 1rem; overflow: hidden; background: var(--glaze-ground, #060d18); animation: preview-arrive .8s ease-out both; }
  .glaze-preview img, .editor-preview img { display: block; width: 100%; height: auto; }
  .glaze-preview figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; padding: 1rem 1.25rem; color: var(--glaze-muted, #a0b9ca); font-size: .72rem; line-height: 1.6; }
  .glaze-preview figcaption a { color: var(--glaze-accent-secondary, #9ce9fa); }
  .glaze-feature { display: block; margin-bottom: 1.25rem; color: var(--glaze-accent, #6fdcff); font-size: .75rem; }
  .editor-preview { padding: .75rem; }
  .glaze-list { display: grid; gap: .6rem; padding: 0; list-style: none; color: var(--glaze-muted, #b3c8dc); font-size: .9rem; line-height: 1.6; }
  .glaze-list strong { color: var(--glaze-ink, #e8f2fa); font-weight: 600; }
  .glaze-inline-link { color: var(--glaze-accent-secondary, #9ce9fa); text-decoration: underline; text-underline-offset: .2em; }
  .browser-guides { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .browser-guide { transition: border-color .2s, transform .2s; }
  .browser-guide:hover { border-color: var(--glaze-accent, #6fdcff); transform: translateY(-3px); }
  .browser-guide .product-eyebrow { display: block; }

  .glaze-page.is-halloween {
    --glaze-accent: #fb923c;
    --glaze-accent-secondary: #6ee7b7;
    --glaze-surface: #1e1426;
    --glaze-ground: #120b18;
    --glaze-ink: #fdf2e9;
    --glaze-muted: #c9b2a6;
    --glaze-line: #47334f;
    --glaze-soft: #171a2e;
    --glaze-hover: #2f2236;
    --product-accent: var(--glaze-accent);
    color: var(--glaze-ink);
  }
  :global(body:has(.glaze-page.is-halloween)) { background: #120b18; }
  :global(body:has(.glaze-page.is-halloween) .marketing) { background: radial-gradient(ellipse 42rem 24rem at 78% 8rem, #3b2352, transparent 80%), linear-gradient(180deg, #241431, #160d20 36rem, #0d0912 62rem, #120b18 95rem); }
  :global(body:has(.glaze-page.is-halloween) .splash-ground),
  :global(body:has(.glaze-page.is-halloween) #splash-canvas) { display: none; }
  :global(body:has(.glaze-page.is-halloween) :is(.marketing-nav, .marketing-footer)) { color: #c9b2a6; }
  :global(body:has(.glaze-page.is-halloween) :is(.marketing-nav, .marketing-footer) a:hover) { color: #6ee7b7; }
  :global(body:has(.glaze-page.is-halloween) :is(.marketing-nav, .marketing-footer) a:focus-visible) { outline-color: #fb923c; }
  :global(body:has(.glaze-page.is-halloween) .skip-link) { color: #fdf2e9; background: #120b18; }
  .is-halloween :is(.product-title, .product-section-heading h2, .product-card h3, .product-panel h3, .product-cta h2) { color: var(--glaze-ink); }
  .is-halloween :is(.product-lead, .product-meta, .product-caption, .product-section-heading > p:not(.product-eyebrow), .product-panel p, .product-cta > p:not(.product-eyebrow)) { color: var(--glaze-muted); }
  .is-halloween :is(.product-card, .product-panel) { background: var(--glaze-surface); border-color: var(--glaze-line); }
  .is-halloween .product-section { border-color: var(--glaze-line); }
  .is-halloween .product-button { color: var(--glaze-ground); }
  .is-halloween .product-button:hover { background: #fdba74; border-color: #fdba74; }
  .is-halloween .product-button.secondary { color: var(--glaze-ink); background: var(--glaze-surface); border-color: var(--glaze-line); }
  .is-halloween .product-button.secondary:hover { background: var(--glaze-hover); border-color: var(--glaze-accent); }
  .is-halloween .browser-guide:hover { border-color: var(--glaze-accent); }
  .is-halloween .product-text-link:hover { color: var(--glaze-ink); }
  .is-halloween .product-cta { position: relative; isolation: isolate; border-color: var(--glaze-line); background: radial-gradient(ellipse at 50% 0%, #fb923c12, transparent 75%), var(--glaze-surface); }
  .is-halloween .product-hero { position: relative; isolation: isolate; padding-bottom: 7rem; }
  .halloween-note { max-width: 27rem; margin-top: 1.25rem; color: var(--glaze-accent-secondary); font-size: .8rem; line-height: 1.65; }
  .halloween-hero, .halloween-ghost, .halloween-skeleton { position: absolute; pointer-events: none; user-select: none; z-index: -1; }
  .halloween-hero { inset: 0; overflow: hidden; }
  .halloween-hero::before { content: ''; position: absolute; inset: 0 0 auto; height: 15rem; background: radial-gradient(circle at 7% 12%, #fef3c74d 0 1px, transparent 1.6px), radial-gradient(circle at 24% 7%, #fef3c733 0 1px, transparent 1.6px), radial-gradient(circle at 45% 10%, #c4b5fd4d 0 1px, transparent 1.6px), radial-gradient(circle at 63% 6%, #fef3c74d 0 1px, transparent 1.6px), radial-gradient(circle at 76% 36%, #c4b5fd33 0 1px, transparent 1.6px), radial-gradient(circle at 95% 11%, #fef3c74d 0 1px, transparent 1.6px); }
  .halloween-moon { position: absolute; width: 11rem; aspect-ratio: 1; top: 1.5rem; right: 8%; border-radius: 50%; background: radial-gradient(circle at 63% 32%, #a78b5b20 0 8%, transparent 9%), radial-gradient(circle at 36% 65%, #a78b5b18 0 12%, transparent 13%), radial-gradient(circle at 70% 69%, #a78b5b18 0 5%, transparent 6%), radial-gradient(circle at 35% 30%, #fef3c7, #fde68a); opacity: .8; box-shadow: 0 0 2.5rem .75rem #fde68a30, 0 0 7rem 2rem #8b5cf633, inset 0 0 1rem #fff7; }
  .halloween-bat { position: absolute; left: 0; width: 5rem; height: auto; opacity: .75; animation: halloween-cross 34s linear infinite; }
  .bat-one { top: 1.5rem; transform: rotate(-12deg); animation-delay: -8s; }
  .bat-two { top: 6rem; width: 3.5rem; animation-duration: 39s; animation-delay: -25s; }
  .bat-three { top: .25rem; width: 2.75rem; animation-duration: 43s; animation-delay: -36s; }
  .halloween-fog { position: absolute; width: 110%; height: 7rem; right: -5%; bottom: -.5rem; opacity: .7; background: radial-gradient(ellipse at 70% 65%, #6ee7b738, transparent 60%), radial-gradient(ellipse at 30% 75%, #c4b5fd38, transparent 65%); filter: blur(10px); animation: halloween-fog 20s ease-in-out infinite alternate; }
