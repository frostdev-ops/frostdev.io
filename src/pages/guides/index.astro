---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import type { MarkdownInstance } from 'astro';
import '../../styles/guides.css';

const guides = [
  { project: 'Rimeward', slug: 'rimeward-first-workspace', title: 'Your project. One connected workspace.', description: 'Bring your folders, Editor, Terminal and Rime together. Make a small change, follow where it runs, and review the result.', image: 'rimeward-workspace.webp', duration: '8 min', topics: ['Workspaces', 'Wards & Leylines', 'Reviewing changes'] },
  { project: 'Crosspane', slug: 'crosspane-two-computers', title: 'Two computers. One flowing desk.', description: 'Pair your devices, arrange their edges, and move naturally between them. Set permissions and learn how to take control back.', image: 'crosspane-windows.webp', duration: '10 min', topics: ['Pairing', 'Display layout', 'Input & projection'] },
  { project: 'Rimewire', slug: 'rimewire-agent-handoffs', title: 'Give the next agent a clear starting point.', description: 'Turn a tracker into a living project board. Define useful work packages, post evidence, and hand off work without losing the thread.', image: 'rimewire-board-progress.webp', duration: '10 min', topics: ['Project boards', 'Work packages', 'Agent handoffs'] },
  { project: 'Frostsim', slug: 'frostsim-first-simulation', title: 'Make your next upgrade an informed one.', description: 'Import a character, run your first simulation, and compare gear against a useful baseline. Understand what the numbers actually say.', image: 'frostsim.webp', duration: '9 min', topics: ['Character import', 'Simulation', 'Gear comparisons'] },
  { project: 'Loothing', slug: 'loothing-raid-loot', title: 'Keep raid loot moving, together.', description: 'Connect your guild, prepare a roster and wishlists, publish a raid, and record the loot. Follow the optional addon workflow when you need it.', image: 'loothing.webp', duration: '12 min', topics: ['Raid setup', 'Wishlists', 'Awards & history'] },
  { project: 'Glaze', slug: 'glaze-safari', title: 'Make Blackboard, Canvas and Moodle yours in Safari.', description: 'Install the Mac app, shape glass and frost, choose a pet, write with Glaze Writer and set up your school workspace.', image: 'glaze-preview.webp', duration: '15 min', topics: ['Safari setup', 'Surfaces & pets', 'Writer & Documents'] },
  { project: 'Glaze', slug: 'glaze-chrome', title: 'Make your school site yours in Chrome or Firefox.', description: 'Install Glaze from Chrome Web Store or Firefox Add-ons, then shape surfaces, choose a pet, write with Glaze Writer and arrange your workspace.', image: 'glaze-editor-4.0.0.webp', duration: '15 min', topics: ['Chrome & Firefox', 'Surfaces & pets', 'Writer & Documents'] },
];
// Glaze's reference docs (src/pages/guides/glaze-[doc].astro), getting started first, building it last.
const order = ['install', 'features', 'privacy', 'mods-api', 'mods-widgets', 'relay', 'development', 'firefox-android'];
const docs = Object.entries(import.meta.glob<MarkdownInstance<{ title: string; description: string }>>('../../content/glaze-docs/*.md', { eager: true }))
  .map(([file, doc]) => ({ slug: file.replace(/^.*\/|\.md$/g, ''), ...doc.frontmatter }))
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
const projects = [...new Set(guides.map((guide) => guide.project))];
const isLogo = (project: string) => project === 'Frostsim' || project === 'Loothing';
---

<MarketingLayout title="Practical project guides — Frostdev" description="Step-by-step guides for Rimeward, Crosspane, Rimewire, Frostsim, Loothing and Glaze for Safari, Chrome and Firefox. Get set up, understand the choices, and check the result." path="/guides">
  <div class="guides-hub">
    <header class="guides-hub-hero">
      <p class="guide-eyebrow">Frostdev field guides</p>
      <h1>From first step<br />to <span>a working flow.</span></h1>
      <p>Good tools get better when you know your way around. Pick a project, follow a real task, and finish with a result you can check.</p>
      <div class="guides-hub-meta"><span class="guides-product-dots" aria-hidden="true">{projects.map((project) => <i data-project={project.toLowerCase()}></i>)}</span><span>{projects.length} projects. {guides.length} practical paths.</span></div>
    </header>

    <div class="guides-collection-heading"><h2>Find your starting point</h2><span>Setup · Workflow · Troubleshooting</span></div>
    <div class="guides-card-grid">
      {guides.map((guide, i) => (
        <a class:list={['guides-card', { 'guides-card-featured': i === 0 }]} data-project={guide.project.toLowerCase()} href={`/guides/${guide.slug}`} style={`--step:${i}`}>
          <div class:list={['guides-card-art', { 'guides-card-art-logo': isLogo(guide.project) }]}>
            <img src={`/projects/${guide.image}`} alt={`${guide.project} ${isLogo(guide.project) ? 'project artwork' : 'interface'}`} width="1000" height="625" loading="lazy" />
            <span class="guides-card-art-tag">{guide.project}</span>
          </div>
          <div class="guides-card-copy">
            <div class="guides-card-meta"><span>{guide.project}</span><span>{guide.duration} read</span></div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <ul class="guides-card-topics" aria-label="Topics">{guide.topics.map((topic) => <li>{topic}</li>)}</ul>
            <span class="guides-card-action">Open the guide <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
    <section id="glaze-docs" class="guides-docs">
      <div class="guides-collection-heading"><h2>Glaze reference</h2><span>Also on <a href="https://github.com/frostdev-ops/glaze/wiki">GitHub's wiki</a></span></div>
      <ul>{docs.map((doc) => <li><a href={`/guides/glaze-${doc.slug}`}>{doc.title}</a><span>{doc.description}</span></li>)}</ul>
    </section>
    <section class="guides-hub-help"><div><p class="guide-eyebrow">A good guide keeps growing</p><h2>Something unclear?</h2><p>These guides follow the projects’ documentation. Check the linked references if your installed version looks different, or tell us which step needs a closer look.</p></div><a href="mailto:admin@frostdev.io">Help improve a guide <span aria-hidden="true">↗</span></a></section>
  </div>
</MarketingLayout>
